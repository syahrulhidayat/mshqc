/**
 * @file src/mp3/omp3.cc
 * @brief Full Iterative 2-RDM Orbital-Optimized MP3
 * @details 
 * - Computes exact T2 amplitudes and 3rd order amplitudes (T2_3rd).
 * - Constructs MP2 + MP3 1-Particle Density Matrix.
 * - Iteratively relaxes orbitals using Backtracking Line Search.
 */

#include "mshqc/omp3.h"
#include "mshqc/ump3_kernels.h"
#include "mshqc/ump3_memory.h"
#include "mshqc/integrals/eri_transformer.h"
#include "mshqc/diis.h"
#include <iostream>
#include <iomanip>
#include <cmath>
#include <omp.h>
#include <algorithm>
#include <vector>
#include <unsupported/Eigen/MatrixFunctions>
#ifdef I
#undef I
#endif

namespace mshqc {

using integrals::ERITransformer;
static UMP3Workspace workspace; 

// ============================================================================
// CONSTRUCTOR
// ============================================================================
OMP3::OMP3(const Molecule& mol, const BasisSet& basis,
           std::shared_ptr<IntegralEngine> integrals,
           const OMP2Result& omp2_result,
           const SCFConfig& config,
           std::shared_ptr<PointGroup> pg,         
           std::shared_ptr<PetiteList> pl)          
    : mol_(mol), basis_(basis), integrals_(integrals), config_(config), 
      pg_(pg), pl_(pl) {
    
    nbf_ = static_cast<int>(basis.n_basis_functions());
    na_ = omp2_result.n_occ_alpha;
    nb_ = omp2_result.n_occ_beta;
    va_ = nbf_ - na_;
    vb_ = nbf_ - nb_;
    
    max_iter_ = config_.max_iterations;
    conv_thresh_ = config_.energy_threshold;
    grad_thresh_ = std::sqrt(config_.energy_threshold);
    
    scf_.energy_total = omp2_result.energy_scf;
    scf_.C_alpha = omp2_result.C_alpha;
    scf_.C_beta = omp2_result.C_beta;
    scf_.orbital_energies_alpha = omp2_result.orbital_energies_alpha;
    scf_.orbital_energies_beta = omp2_result.orbital_energies_beta;
    scf_.n_occ_alpha = na_;
    scf_.n_occ_beta = nb_;

    scf_.P_alpha = scf_.C_alpha.leftCols(na_) * scf_.C_alpha.leftCols(na_).transpose();
    scf_.P_beta = scf_.C_beta.leftCols(nb_) * scf_.C_beta.leftCols(nb_).transpose();

    if (pg_ && pl_) {
        symmetrizer_ = std::make_unique<BasisSymmetrizer>(basis_, *pg_, *pl_);
    }
    init_fast_integrals();
}

// ------------------------------------------------------------------
// INIT: LINEARIZED MEMORY & SCHWARTZ SCREENING UNTUK OMP3
// ------------------------------------------------------------------
void OMP3::init_fast_integrals() {
    S_ = integrals_->compute_overlap();
    H_core_ = integrals_->compute_core_hamiltonian();

    J_val_.clear(); J_ind_.clear(); J_ptr_.clear();
    K_val_.clear(); K_ind_.clear(); K_ptr_.clear();
    row_map_.clear();
    
    long long est_nnz = (long long)(std::pow(nbf_, 4) * 0.15); 
    J_val_.reserve(est_nnz); J_ind_.reserve(est_nnz);
    K_val_.reserve(est_nnz); K_ind_.reserve(est_nnz);
    row_map_.reserve(nbf_ * nbf_ / 2);
    
    schwarz_ = Eigen::MatrixXd::Zero(nbf_, nbf_);
    J_ptr_.push_back(0);
    K_ptr_.push_back(0);

    auto ERI = integrals_->compute_eri(); 
    const double sparse_threshold = 1e-12;

    int nshells = basis_.n_shells();
    std::vector<int> shell_starts(nshells), shell_sizes(nshells);
    int offset = 0;
    for(int i=0; i<nshells; ++i) {
        shell_starts[i] = offset;
        shell_sizes[i] = basis_.shell(i).n_functions();
        offset += shell_sizes[i];
    }

    std::vector<std::pair<int, int>> shell_pairs;
    
    // ============================================================
    // OPTIMASI SIMETRI AKTIF (Petite List & Point Group)
    // ============================================================
    if (pl_) {
        // Hanya ambil pasangan shell yang unik secara simetri
        const auto& pairs = pl_->get_unique_pairs();
        for(const auto& p : pairs) {
            shell_pairs.push_back({p.p, p.q});
        }
    } else {
        // Fallback aman jika PointGroup dimatikan (C1 symmetry)
        for(int i=0; i<nshells; ++i) {
            for(int j=0; j<=i; ++j) {
                shell_pairs.push_back({i, j});
            }
        }
    }
    // ============================================================

    for (const auto& pair_ij : shell_pairs) {
        int sh_i = pair_ij.first; int sh_j = pair_ij.second;
        int istart = shell_starts[sh_i]; int isize = shell_sizes[sh_i];
        int jstart = shell_starts[sh_j]; int jsize = shell_sizes[sh_j];

        for (int i = 0; i < isize; ++i) {
            for (int j = 0; j < jsize; ++j) {
                int mu = istart + i;
                int nu = jstart + j;
                
                if (sh_i == sh_j && nu > mu) continue;

                row_map_.push_back({mu, nu});
                double max_val_row = 0.0;
                
                for (int sig = 0; sig < nbf_; ++sig) {
                    for (int lam = 0; lam < nbf_; ++lam) {
                        int density_idx = lam + sig * nbf_; 
                        double vJ = ERI(mu, nu, lam, sig);
                        if (std::abs(vJ) > sparse_threshold) {
                            J_val_.push_back(vJ);
                            J_ind_.push_back(density_idx);
                            max_val_row = std::max(max_val_row, std::abs(vJ));
                        }
                        double vK = ERI(mu, lam, nu, sig);
                        if (std::abs(vK) > sparse_threshold) {
                            K_val_.push_back(vK);
                            K_ind_.push_back(density_idx);
                        }
                    }
                }
                J_ptr_.push_back(J_val_.size());
                K_ptr_.push_back(K_val_.size());
                
                schwarz_(mu, nu) = std::sqrt(max_val_row);
                schwarz_(nu, mu) = std::sqrt(max_val_row);
            }
        }
    }
}

// ============================================================================
// HELPERS
// ============================================================================
static Eigen::MatrixXd pack_ladder_vvvv_as(const Eigen::Tensor<double, 4>& V, int nv) {
    if(nv == 0) return Eigen::MatrixXd();
    Eigen::MatrixXd M(nv*nv, nv*nv);
    #pragma omp parallel for collapse(2)
    for(int ab = 0; ab < nv*nv; ++ab) {
        for(int cd = 0; cd < nv*nv; ++cd) {
            int a = ab / nv; int b = ab % nv;
            int c = cd / nv; int d = cd % nv;
            M(ab, cd) = V(a,c,b,d) - V(a,d,b,c);
        }
    }
    return M;
}

static Eigen::MatrixXd pack_ladder_oooo_as(const Eigen::Tensor<double, 4>& V, int no) {
    if(no == 0) return Eigen::MatrixXd();
    Eigen::MatrixXd M(no*no, no*no);
    #pragma omp parallel for collapse(2)
    for(int kl = 0; kl < no*no; ++kl) {
        for(int ij = 0; ij < no*no; ++ij) {
            int k = kl / no; int l = kl % no;
            int i = ij / no; int j = ij % no;
            M(kl, ij) = V(k,i,l,j) - V(k,j,l,i);
        }
    }
    return M;
}

static Eigen::MatrixXd pack_t2_ij_ab(const Eigen::Tensor<double, 4>& T2, int no, int nv) {
    if(no == 0 || nv == 0) return Eigen::MatrixXd();
    Eigen::MatrixXd M(no*no, nv*nv);
    #pragma omp parallel for collapse(2)
    for(int ij = 0; ij < no*no; ++ij) {
        for(int ab = 0; ab < nv*nv; ++ab) {
            int i = ij / no; int j = ij % no;
            int a = ab / nv; int b = ab % nv;
            M(ij, ab) = T2(i,j,a,b);
        }
    }
    return M;
}

void OMP3::build_fock_fast(const Eigen::MatrixXd& P_a, const Eigen::MatrixXd& P_b,
                           Eigen::MatrixXd& F_a, Eigen::MatrixXd& F_b)
{
    Eigen::MatrixXd P_tot = P_a + P_b;
    double max_P = P_tot.cwiseAbs().maxCoeff(); 
    double threshold = 1e-9; 

    const double* __restrict__ p_dtot = P_tot.data();
    const double* __restrict__ p_da   = P_a.data();
    const double* __restrict__ p_db   = P_b.data();
    
    const double* __restrict__ Jv = J_val_.data(); 
    const int* __restrict__ Ji = J_ind_.data(); 
    const size_t* __restrict__ Jp = J_ptr_.data();
    const double* __restrict__ Kv = K_val_.data(); 
    const int* __restrict__ Ki = K_ind_.data(); 
    const size_t* __restrict__ Kp = K_ptr_.data();

    int n_threads = omp_get_max_threads();
    std::vector<Eigen::MatrixXd> Ga_priv(n_threads, Eigen::MatrixXd::Zero(nbf_, nbf_));
    std::vector<Eigen::MatrixXd> Gb_priv(n_threads, Eigen::MatrixXd::Zero(nbf_, nbf_));

    size_t n_rows = row_map_.size();
    
    #pragma omp parallel for schedule(dynamic, 16)
    for (size_t r = 0; r < n_rows; ++r) {
        int mu = row_map_[r].first;
        int nu = row_map_[r].second;
        
        if (schwarz_(mu, nu) * max_P < threshold) continue;

        size_t js = Jp[r]; size_t je = Jp[r+1];
        size_t ks = Kp[r]; size_t ke = Kp[r+1];

        double vj = 0.0;
        #pragma omp simd reduction(+:vj)
        for (size_t k = js; k < je; ++k) vj += Jv[k] * p_dtot[Ji[k]];

        double ka = 0.0, kb = 0.0;
        #pragma omp simd reduction(+:ka, kb)
        for (size_t k = ks; k < ke; ++k) {
            double v = Kv[k]; int idx = Ki[k];
            ka += v * p_da[idx];
            kb += v * p_db[idx];
        }
        
        int tid = omp_get_thread_num();
        Ga_priv[tid](mu, nu) += vj - ka;
        Gb_priv[tid](mu, nu) += vj - kb;
    }

    Eigen::MatrixXd G_a = Eigen::MatrixXd::Zero(nbf_, nbf_);
    Eigen::MatrixXd G_b = Eigen::MatrixXd::Zero(nbf_, nbf_);

    for (int t = 0; t < n_threads; ++t) { G_a += Ga_priv[t]; G_b += Gb_priv[t]; }
    
    for (int i = 0; i < nbf_; ++i) {
        for (int j = 0; j < i; ++j) {
            G_a(j, i) = G_a(i, j); G_b(j, i) = G_b(i, j);
        }
    }

    F_a = H_core_ + G_a;
    F_b = H_core_ + G_b;
    
}
void OMP3::pseudocanonicalize() {
    Eigen::MatrixXd F_alpha, F_beta;
    build_fock_fast(scf_.P_alpha, scf_.P_beta, F_alpha, F_beta);

    if (symmetrizer_) {
        symmetrizer_->symmetrize(F_alpha);
        symmetrizer_->symmetrize(F_beta);
    }
    
    auto diag_block = [&](Eigen::MatrixXd& C, Eigen::VectorXd& eps, const Eigen::MatrixXd& F_ao, int n_occ, int n_virt) {
        Eigen::MatrixXd F_mo = C.transpose() * F_ao * C;
        eps.resize(n_occ + n_virt);
        if (n_occ > 0) {
            Eigen::SelfAdjointEigenSolver<Eigen::MatrixXd> es_o(F_mo.block(0, 0, n_occ, n_occ));
            eps.head(n_occ) = es_o.eigenvalues();
            C.leftCols(n_occ) = C.leftCols(n_occ) * es_o.eigenvectors();
        }
        if (n_virt > 0) {
            Eigen::SelfAdjointEigenSolver<Eigen::MatrixXd> es_v(F_mo.block(n_occ, n_occ, n_virt, n_virt));
            eps.tail(n_virt) = es_v.eigenvalues();
            C.rightCols(n_virt) = C.rightCols(n_virt) * es_v.eigenvectors();
        }
    };
    
    diag_block(scf_.C_alpha, scf_.orbital_energies_alpha, F_alpha, na_, va_);
    diag_block(scf_.C_beta, scf_.orbital_energies_beta, F_beta, nb_, vb_);
    
    scf_.P_alpha = scf_.C_alpha.leftCols(na_) * scf_.C_alpha.leftCols(na_).transpose();
    scf_.P_beta = scf_.C_beta.leftCols(nb_) * scf_.C_beta.leftCols(nb_).transpose();
}

double OMP3::compute_mp2_energy() {
    if (na_ == 0 || va_ == 0) return 0.0;
    t2_aa_ = Eigen::Tensor<double, 4>(na_, na_, va_, va_);
    if (nb_ > 0 && vb_ > 0) {
        t2_bb_ = Eigen::Tensor<double, 4>(nb_, nb_, vb_, vb_);
        t2_ab_ = Eigen::Tensor<double, 4>(na_, nb_, va_, vb_);
    }
    const auto& eri_ao = integrals_->compute_eri();
    const Eigen::MatrixXd& Cao = scf_.C_alpha.leftCols(na_);
    const Eigen::MatrixXd& Cav = scf_.C_alpha.rightCols(va_);
    const auto& ea = scf_.orbital_energies_alpha;
    double e_sum = 0.0;

    {
        auto g_aa = ERITransformer::transform_ovov(eri_ao, Cao, Cav, nbf_, na_, va_);
        double e_aa = 0.0;
        #pragma omp parallel for collapse(4) reduction(+:e_aa)
        for(int i=0; i<na_; ++i) for(int j=0; j<na_; ++j) 
            for(int a=0; a<va_; ++a) for(int b=0; b<va_; ++b) {
                double D = ea(i)+ea(j)-ea(na_+a)-ea(na_+b);
                if(std::abs(D)>1e-12) {
                    double val = g_aa(i,a,j,b) - g_aa(i,b,j,a);
                    t2_aa_(i,j,a,b) = val / D;
                    e_aa += t2_aa_(i,j,a,b) * val;
                } else t2_aa_(i,j,a,b) = 0.0;
            }
        e_sum += 0.25 * e_aa;
    }

    if (nb_ > 0 && vb_ > 0) {
        const Eigen::MatrixXd& Cbo = scf_.C_beta.leftCols(nb_);
        const Eigen::MatrixXd& Cbv = scf_.C_beta.rightCols(vb_);
        const auto& eb = scf_.orbital_energies_beta;
        {
            auto g_bb = ERITransformer::transform_ovov(eri_ao, Cbo, Cbv, nbf_, nb_, vb_);
            double e_bb = 0.0;
            #pragma omp parallel for collapse(4) reduction(+:e_bb)
            for(int i=0; i<nb_; ++i) for(int j=0; j<nb_; ++j)
                for(int a=0; a<vb_; ++a) for(int b=0; b<vb_; ++b) {
                    double D = eb(i)+eb(j)-eb(nb_+a)-eb(nb_+b);
                    if(std::abs(D)>1e-12) {
                        double val = g_bb(i,a,j,b) - g_bb(i,b,j,a);
                        t2_bb_(i,j,a,b) = val / D;
                        e_bb += t2_bb_(i,j,a,b) * val;
                    } else t2_bb_(i,j,a,b) = 0.0;
                }
            e_sum += 0.25 * e_bb;
        }
        {
            auto g_ab = ERITransformer::transform_oovv_mixed(eri_ao, Cao, Cbo, Cav, Cbv, nbf_, na_, nb_, va_, vb_);
            double e_ab = 0.0;
            #pragma omp parallel for collapse(4) reduction(+:e_ab)
            for(int i=0; i<na_; ++i) for(int j=0; j<nb_; ++j)
                for(int a=0; a<va_; ++a) for(int b=0; b<vb_; ++b) {
                    double D = ea(i)+eb(j)-ea(na_+a)-eb(nb_+b);
                    if(std::abs(D)>1e-12) {
                        double val = g_ab(i,a,j,b);
                        t2_ab_(i,j,a,b) = val / D;
                        e_ab += t2_ab_(i,j,a,b) * val;
                    } else t2_ab_(i,j,a,b) = 0.0;
                }
            e_sum += e_ab;
        }
    }
    return e_sum;
}

double OMP3::compute_mp3_correction() {
    if (na_ == 0 || va_ == 0) return 0.0;
    const auto& eri_ao = integrals_->compute_eri();
    const Eigen::MatrixXd& Cao = scf_.C_alpha.leftCols(na_);
    const Eigen::MatrixXd& Cav = scf_.C_alpha.rightCols(va_);
    const auto& ea = scf_.orbital_energies_alpha;
    double E3_aa = 0.0, E3_bb = 0.0, E3_ab = 0.0;

    t2_3rd_aa_ = Eigen::Tensor<double, 4>(na_, na_, va_, va_); t2_3rd_aa_.setZero();
    if (nb_ > 0 && vb_ > 0) {
        t2_3rd_bb_ = Eigen::Tensor<double, 4>(nb_, nb_, vb_, vb_); t2_3rd_bb_.setZero();
        t2_3rd_ab_ = Eigen::Tensor<double, 4>(na_, nb_, va_, vb_); t2_3rd_ab_.setZero();
    }

    auto& ovov_aa = workspace.allocate("ovov_aa", na_, va_, na_, va_);
    ovov_aa = ERITransformer::transform_ovov(eri_ao, Cao, Cav, nbf_, na_, va_);
    auto& oovv_aa = workspace.allocate("oovv_aa", na_, na_, va_, va_);
    oovv_aa = ERITransformer::transform_oo_vv_mixed(eri_ao, Cao, Cao, Cav, Cav, nbf_, na_, na_, va_, va_);

    if (nb_ > 0 && vb_ > 0) {
        const Eigen::MatrixXd& Cbo = scf_.C_beta.leftCols(nb_);
        const Eigen::MatrixXd& Cbv = scf_.C_beta.rightCols(vb_);
        auto& ovov_bb = workspace.allocate("ovov_bb", nb_, vb_, nb_, vb_);
        ovov_bb = ERITransformer::transform_ovov(eri_ao, Cbo, Cbv, nbf_, nb_, vb_);
        auto& ovov_ab = workspace.allocate("ovov_ab", na_, va_, nb_, vb_);
        ovov_ab = ERITransformer::transform_oovv_mixed(eri_ao, Cao, Cbo, Cav, Cbv, nbf_, na_, nb_, va_, vb_);
        auto& oovv_bb = workspace.allocate("oovv_bb", nb_, nb_, vb_, vb_);
        oovv_bb = ERITransformer::transform_oo_vv_mixed(eri_ao, Cbo, Cbo, Cbv, Cbv, nbf_, nb_, nb_, vb_, vb_);
        auto& oovv_ab_ex = workspace.allocate("oovv_ab_ex", na_, na_, vb_, vb_);
        oovv_ab_ex = ERITransformer::transform_oo_vv_mixed(eri_ao, Cao, Cao, Cbv, Cbv, nbf_, na_, na_, vb_, vb_);
        auto& oovv_ba_ex = workspace.allocate("oovv_ba_ex", nb_, nb_, va_, va_);
        oovv_ba_ex = ERITransformer::transform_oo_vv_mixed(eri_ao, Cbo, Cbo, Cav, Cav, nbf_, nb_, nb_, va_, va_);
    }

    // Lambda aman untuk unpacking dari (ij, ab) -> (ia, jb)
    auto unpack_add_ijab_to_iajb = [](const Eigen::MatrixXd& W_ijab, Eigen::MatrixXd& W_iajb, int no, int nv) {
        #pragma omp parallel for collapse(2)
        for(int i = 0; i < no; ++i) {
            for(int j = 0; j < no; ++j) {
                for(int a = 0; a < nv; ++a) {
                    for(int b = 0; b < nv; ++b) {
                        W_iajb(i*nv + a, j*nv + b) += W_ijab(i*no + j, a*nv + b);
                    }
                }
            }
        }
    };

    // --- AA CHANNEL ---
    {
        int dim_aa = na_ * va_;
        Eigen::MatrixXd W_res_AA = Eigen::MatrixXd::Zero(dim_aa, dim_aa);

        {
            auto& V = workspace.allocate("vvvv_aa", va_, va_, va_, va_);
            V = ERITransformer::transform_vvvv(eri_ao, Cav, nbf_, va_);
            Eigen::MatrixXd W_ijab = 0.5 * (pack_t2_ij_ab(t2_aa_, na_, va_) * pack_ladder_vvvv_as(V, va_)); 
            unpack_add_ijab_to_iajb(W_ijab, W_res_AA, na_, va_);
            workspace.free("vvvv_aa"); 
        }
        {
            auto& V = workspace.allocate("oooo_aa", na_, na_, na_, na_);
            V = ERITransformer::transform_oooo(eri_ao, Cao, nbf_, na_);
            Eigen::MatrixXd W_ijab = 0.5 * (pack_ladder_oooo_as(V, na_).transpose() * pack_t2_ij_ab(t2_aa_, na_, va_));
            unpack_add_ijab_to_iajb(W_ijab, W_res_AA, na_, va_);
            workspace.free("oooo_aa");
        }
        {
            Eigen::MatrixXd V_AA(dim_aa, dim_aa), T_right(dim_aa, dim_aa);
            #pragma omp parallel for collapse(2)
            for(int ia=0; ia<dim_aa; ++ia) {
                for(int kc=0; kc<dim_aa; ++kc) {
                    int i = ia/va_; int a = ia%va_; int k = kc/va_; int c = kc%va_;
                    V_AA(ia, kc) = ovov_aa(i,a,k,c) - oovv_aa(k,i,a,c);
                }
            }
            #pragma omp parallel for collapse(2)
            for(int kc=0; kc<dim_aa; ++kc) {
                for(int jb=0; jb<dim_aa; ++jb) {
                    int k = kc/va_; int c = kc%va_; int j = jb/va_; int b = jb%va_;
                    T_right(kc, jb) = t2_aa_(k,j,c,b);
                }
            }
            
            // 1. Hitung Ring mentah untuk AA (tanpa pengali 4.0)
            Eigen::MatrixXd Ring_raw_AA = V_AA * T_right;

            // 2. Hitung dan tambahkan kontribusi cross-spin (AB) jika sistem Open-Shell
            if (nb_ > 0 && vb_ > 0) {
                const auto& g_ovov_ab = workspace.get("ovov_ab");
                Eigen::MatrixXd V_cr(na_*va_, nb_*vb_), T_cr(nb_*vb_, na_*va_);
                #pragma omp parallel for collapse(2)
                for (int i = 0; i < na_; ++i) for (int a = 0; a < va_; ++a)
                    for (int k = 0; k < nb_; ++k) for (int c = 0; c < vb_; ++c) {
                        V_cr(i*va_+a, k*vb_+c) = g_ovov_ab(i, a, k, c);
                    }
                #pragma omp parallel for collapse(2)
                for (int k = 0; k < nb_; ++k) for (int c = 0; c < vb_; ++c)
                    for (int j = 0; j < na_; ++j) for (int b = 0; b < va_; ++b) {
                        T_cr(k*vb_+c, j*va_+b) = t2_ab_(j, k, b, c);
                    }
                Ring_raw_AA += V_cr * T_cr;
            }

            // 3. Lakukan Anti-Simetrisasi Eksplisit
            // (i <-> j) dan (a <-> b) untuk menjaga sifat tensor sebelum masuk ke amplitudo
            #pragma omp parallel for collapse(2)
            for(int i=0; i<na_; ++i) {
                for(int j=0; j<na_; ++j) {
                    for(int a=0; a<va_; ++a) {
                        for(int b=0; b<va_; ++b) {
                            W_res_AA(i*va_ + a, j*va_ + b) += 
                                  Ring_raw_AA(i*va_ + a, j*va_ + b) 
                                - Ring_raw_AA(j*va_ + a, i*va_ + b) 
                                - Ring_raw_AA(i*va_ + b, j*va_ + a) 
                                + Ring_raw_AA(j*va_ + b, i*va_ + a);
                        }
                    }
                }
            }
        }

        Eigen::MatrixXd T_iajb_AA(dim_aa, dim_aa);
        #pragma omp parallel for collapse(2)
        for(int ia=0; ia<dim_aa; ++ia) {
            for(int jb=0; jb<dim_aa; ++jb) {
                int i = ia/va_; int a = ia%va_; int j = jb/va_; int b = jb%va_;
                T_iajb_AA(ia, jb) = t2_aa_(i, j, a, b);
                double D = ea(i) + ea(j) - ea(na_+a) - ea(na_+b);
                if (std::abs(D) > 1e-12) {
                    double val = W_res_AA(ia, jb) / D;
                    t2_3rd_aa_(i, j, a, b) = val;
                    
                }
            }
        }
        E3_aa = 0.25 * T_iajb_AA.cwiseProduct(W_res_AA).sum();
    }

    if (nb_ > 0 && vb_ > 0) {
        const Eigen::MatrixXd& Cbo = scf_.C_beta.leftCols(nb_);
        const Eigen::MatrixXd& Cbv = scf_.C_beta.rightCols(vb_);
        const auto& eb = scf_.orbital_energies_beta;
        const auto& g_ovov_ab = workspace.get("ovov_ab");

        // --- BB CHANNEL ---
        {
            int dim_bb = nb_ * vb_;
            Eigen::MatrixXd W_res_BB = Eigen::MatrixXd::Zero(dim_bb, dim_bb);

            {
                auto& V = workspace.allocate("vvvv_bb", vb_, vb_, vb_, vb_);
                V = ERITransformer::transform_vvvv(eri_ao, Cbv, nbf_, vb_);
                Eigen::MatrixXd W_ijab = 0.5 * (pack_t2_ij_ab(t2_bb_, nb_, vb_) * pack_ladder_vvvv_as(V, vb_)); 
                unpack_add_ijab_to_iajb(W_ijab, W_res_BB, nb_, vb_);
                workspace.free("vvvv_bb");
            }
            {
                auto& V_o = workspace.allocate("oooo_bb", nb_, nb_, nb_, nb_);
                V_o = ERITransformer::transform_oooo(eri_ao, Cbo, nbf_, nb_);
                Eigen::MatrixXd W_ijab = 0.5 * (pack_ladder_oooo_as(V_o, nb_).transpose() * pack_t2_ij_ab(t2_bb_, nb_, vb_));
                unpack_add_ijab_to_iajb(W_ijab, W_res_BB, nb_, vb_);
                workspace.free("oooo_bb");
            }
            {
            const auto& ovov_bb = workspace.get("ovov_bb");
            const auto& oovv_bb = workspace.get("oovv_bb");
            Eigen::MatrixXd V_BB(dim_bb, dim_bb), T_right(dim_bb, dim_bb);
            #pragma omp parallel for collapse(2)
            for(int ia=0; ia<dim_bb; ++ia) {
                for(int kc=0; kc<dim_bb; ++kc) {
                    int i = ia/vb_; int a = ia%vb_; int k = kc/vb_; int c = kc%vb_;
                    V_BB(ia, kc) = ovov_bb(i,a,k,c) - oovv_bb(k,i,a,c);
                }
            }
            #pragma omp parallel for collapse(2)
            for(int kc=0; kc<dim_bb; ++kc) {
                for(int jb=0; jb<dim_bb; ++jb) {
                    int k = kc/vb_; int c = kc%vb_; int j = jb/vb_; int b = jb%vb_;
                    T_right(kc, jb) = t2_bb_(k, j, c, b);
                }
            }

            // 1. Hitung Ring mentah untuk BB (tanpa pengali 4.0)
            Eigen::MatrixXd Ring_raw_BB = V_BB * T_right;

            // 2. Tambahkan coupling AB (cross-spin)
            Eigen::MatrixXd V_cr(nb_*vb_, na_*va_), T_cr(na_*va_, nb_*vb_);
            #pragma omp parallel for collapse(2)
            for (int i = 0; i < nb_; ++i) for (int a = 0; a < vb_; ++a)
                for (int k = 0; k < na_; ++k) for (int c = 0; c < va_; ++c) {
                    V_cr(i*vb_+a, k*va_+c) = g_ovov_ab(k, c, i, a);
                }
            #pragma omp parallel for collapse(2)
            for (int k = 0; k < na_; ++k) for (int c = 0; c < va_; ++c)
                for (int j = 0; j < nb_; ++j) for (int b = 0; b < vb_; ++b) {
                    T_cr(k*va_+c, j*vb_+b) = t2_ab_(k, j, c, b);
                }
            Ring_raw_BB += V_cr * T_cr;

            // 3. Lakukan Anti-Simetrisasi Eksplisit
            #pragma omp parallel for collapse(2)
            for(int i=0; i<nb_; ++i) {
                for(int j=0; j<nb_; ++j) {
                    for(int a=0; a<vb_; ++a) {
                        for(int b=0; b<vb_; ++b) {
                            W_res_BB(i*vb_ + a, j*vb_ + b) += 
                                  Ring_raw_BB(i*vb_ + a, j*vb_ + b) 
                                - Ring_raw_BB(j*vb_ + a, i*vb_ + b) 
                                - Ring_raw_BB(i*vb_ + b, j*vb_ + a) 
                                + Ring_raw_BB(j*vb_ + b, i*vb_ + a);
                        }
                    }
                }
            }


        }

            Eigen::MatrixXd T_iajb_BB(dim_bb, dim_bb);
            #pragma omp parallel for collapse(2)
            for(int ia=0; ia<dim_bb; ++ia) {
                for(int jb=0; jb<dim_bb; ++jb) {
                    int i = ia/vb_; int a = ia%vb_; int j = jb/vb_; int b = jb%vb_;
                    T_iajb_BB(ia, jb) = t2_bb_(i, j, a, b);
                    double D = eb(i) + eb(j) - eb(nb_+a) - eb(nb_+b);
                    if (std::abs(D) > 1e-12) {
                        double val = W_res_BB(ia, jb) / D;
                        // Batasi amplitudo maksimal di angka 5.0
                        t2_3rd_bb_(i,j,a,b) = val;
                    }
                }
            }
            E3_bb = 0.25 * T_iajb_BB.cwiseProduct(W_res_BB).sum();
        }

        // --- AB CHANNEL ---
        // (Logika AB pada dasarnya sudah terbebas dari bug DGEMM sejak awal karena menggunakan loops dan cross-terms yang dimensinya sinkron)
        {
            int dim_ia = na_ * va_; int dim_jb = nb_ * vb_;
            Eigen::MatrixXd W_total_AB = Eigen::MatrixXd::Zero(dim_ia, dim_jb);
            Eigen::MatrixXd T_iajb(dim_ia, dim_jb);
            for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
                for(int j=0; j<nb_; ++j) for(int b=0; b<vb_; ++b) 
                    T_iajb(i*va_+a, j*vb_+b) = t2_ab_(i,j,a,b);

            // Ladder VVVV Mixed
            auto& Vv = workspace.allocate("vvvv_ab", va_, va_, vb_, vb_); 
            Vv = ERITransformer::transform_vvvv_mixed(eri_ao, Cav, Cbv, nbf_, va_, vb_);
            #pragma omp parallel for collapse(2)
            for(int i=0; i<na_; ++i) {
                for(int j=0; j<nb_; ++j) {
                    for(int a=0; a<va_; ++a) {
                        for(int b=0; b<vb_; ++b) {
                            double sum = 0;
                            for(int c=0; c<va_; ++c) {
                                for(int d=0; d<vb_; ++d) {
                                    sum += Vv(a, c, b, d) * t2_ab_(i, j, c, d);
                                }
                            }
                            W_total_AB(i*va_+a, j*vb_+b) += sum;
                        }
                    }
                }
            }
            workspace.free("vvvv_ab");

            // Ladder OOOO Mixed
            auto& Vo = workspace.allocate("oooo_ab", na_, na_, nb_, nb_);
            Vo = ERITransformer::transform_oooo_mixed(eri_ao, Cao, Cbo, nbf_, na_, nb_);
            #pragma omp parallel for collapse(2)
            for(int i=0; i<na_; ++i) {
                for(int j=0; j<nb_; ++j) {
                    for(int a=0; a<va_; ++a) {
                        for(int b=0; b<vb_; ++b) {
                            double sum = 0;
                            for(int k=0; k<na_; ++k) {
                                for(int l=0; l<nb_; ++l) {
                                    sum += Vo(k, i, l, j) * t2_ab_(k, l, a, b);
                                }
                            }
                            W_total_AB(i*va_+a, j*vb_+b) += sum;
                        }
                    }
                }
            }
            workspace.free("oooo_ab");

            // Ring AB (6 Exact Terms)
            const auto& g_oovv_ab_ex = workspace.get("oovv_ab_ex");
            const auto& g_oovv_ba_ex = workspace.get("oovv_ba_ex");
            const auto& ovov_bb = workspace.get("ovov_bb");
            const auto& oovv_bb = workspace.get("oovv_bb");

            Eigen::MatrixXd V_AA(dim_ia, na_*va_);
            for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
                for(int k=0; k<na_; ++k) for(int c=0; c<va_; ++c) 
                    V_AA(i*va_+a, k*va_+c) = ovov_aa(i,a,k,c) - oovv_aa(i,k,a,c);
            W_total_AB += V_AA * T_iajb; 

            Eigen::MatrixXd T_AB_ik(dim_ia, nb_*vb_);
            for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
                for(int k=0; k<nb_; ++k) for(int c=0; c<vb_; ++c) 
                    T_AB_ik(i*va_+a, k*vb_+c) = t2_ab_(i,k,a,c);
            Eigen::MatrixXd V_BB(nb_*vb_, dim_jb);
            for(int k=0; k<nb_; ++k) for(int c=0; c<vb_; ++c) 
                for(int j=0; j<nb_; ++j) for(int b=0; b<vb_; ++b) 
                    V_BB(k*vb_+c, j*vb_+b) = ovov_bb(k,c,j,b) - oovv_bb(k,j,c,b);
            W_total_AB += T_AB_ik * V_BB; 

            Eigen::MatrixXd T_AA(dim_ia, na_*va_);
            for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
                for(int k=0; k<na_; ++k) for(int c=0; c<va_; ++c) 
                    T_AA(i*va_+a, k*va_+c) = t2_aa_(i,k,a,c);
            Eigen::MatrixXd V_AB(na_*va_, dim_jb);
            for(int k=0; k<na_; ++k) for(int c=0; c<va_; ++c) 
                for(int j=0; j<nb_; ++j) for(int b=0; b<vb_; ++b) 
                    V_AB(k*va_+c, j*vb_+b) = g_ovov_ab(k, c, j, b);
            W_total_AB += T_AA * V_AB;

            Eigen::MatrixXd V_AB_T4(dim_ia, nb_*vb_);
            for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
                for(int k=0; k<nb_; ++k) for(int c=0; c<vb_; ++c) 
                    V_AB_T4(i*va_+a, k*vb_+c) = g_ovov_ab(i, a, k, c); 
            Eigen::MatrixXd T_BB(nb_*vb_, dim_jb);
            for(int k=0; k<nb_; ++k) for(int c=0; c<vb_; ++c) 
                for(int j=0; j<nb_; ++j) for(int b=0; b<vb_; ++b) 
                    T_BB(k*vb_+c, j*vb_+b) = t2_bb_(k,j,c,b);
            W_total_AB += V_AB_T4 * T_BB;

            Eigen::MatrixXd V_C1(na_*vb_, na_*vb_), T_C1(na_*vb_, nb_*va_);
            for(int i=0; i<na_; ++i) for(int b=0; b<vb_; ++b) 
                for(int k=0; k<na_; ++k) for(int c=0; c<vb_; ++c) 
                    V_C1(i*vb_+b, k*vb_+c) = g_oovv_ab_ex(i,k,b,c); 
            for(int k=0; k<na_; ++k) for(int c=0; c<vb_; ++c) 
                for(int j=0; j<nb_; ++j) for(int a=0; a<va_; ++a) 
                    T_C1(k*vb_+c, j*va_+a) = t2_ab_(k,j,a,c);
            Eigen::MatrixXd W_C1 = V_C1 * T_C1;
            for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
                for(int j=0; j<nb_; ++j) for(int b=0; b<vb_; ++b) 
                    W_total_AB(i*va_+a, j*vb_+b) -= W_C1(i*vb_+b, j*va_+a);

            Eigen::MatrixXd V_C2(nb_*va_, nb_*va_), T_C2(nb_*va_, na_*vb_);
            for(int j=0; j<nb_; ++j) for(int a=0; a<va_; ++a) 
                for(int k=0; k<nb_; ++k) for(int c=0; c<va_; ++c) 
                    V_C2(j*va_+a, k*va_+c) = g_oovv_ba_ex(j,k,a,c);
            for(int k=0; k<nb_; ++k) for(int c=0; c<va_; ++c) 
                for(int i=0; i<na_; ++i) for(int b=0; b<vb_; ++b) 
                    T_C2(k*va_+c, i*vb_+b) = t2_ab_(i,k,c,b);
            Eigen::MatrixXd W_C2 = V_C2 * T_C2;
            for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
                for(int j=0; j<nb_; ++j) for(int b=0; b<vb_; ++b) 
                    W_total_AB(i*va_+a, j*vb_+b) -= W_C2(j*va_+a, i*vb_+b);

            E3_ab = 1.0 * T_iajb.cwiseProduct(W_total_AB).sum();
            
        
            #pragma omp parallel for collapse(2)
            for(int ia=0; ia<dim_ia; ++ia) {
                for(int jb=0; jb<dim_jb; ++jb) {
                    int i = ia/va_; int a = ia%va_; int j = jb/vb_; int b = jb%vb_;
                    double D = ea(i) + eb(j) - ea(na_+a) - eb(nb_+b);
                    if (std::abs(D) > 1e-12) {
                        double val = W_total_AB(ia, jb) / D;
                        // Batasi amplitudo maksimal di angka 5.0
                        t2_3rd_ab_(i,j,a,b) =  val;
                    }
                }
            }
        }
    }
    

    
    return E3_aa + E3_bb + E3_ab;
}

struct ZDIIS_Tensor {
    std::vector<Eigen::Tensor<double, 4>> tensor_hist; 
    std::vector<Eigen::Tensor<double, 4>> error_hist;  
    int max_vec = 6;
    
    void push(const Eigen::Tensor<double, 4>& val, const Eigen::Tensor<double, 4>& err) {
        tensor_hist.push_back(val);
        error_hist.push_back(err);
        if ((int)tensor_hist.size() > max_vec) {
            tensor_hist.erase(tensor_hist.begin());
            error_hist.erase(error_hist.begin());
        }
    }
    
    Eigen::Tensor<double, 4> extrapolate(int n1, int n2, int n3, int n4) {
        int n = tensor_hist.size();
        if (n < 2) return tensor_hist.back();
        
        Eigen::MatrixXd B = Eigen::MatrixXd::Zero(n+1, n+1);
        for (int i = 0; i < n; ++i) {
            Eigen::Map<const Eigen::VectorXd> err_i(error_hist[i].data(), error_hist[i].size());
            for (int j = 0; j <= i; ++j) {
                Eigen::Map<const Eigen::VectorXd> err_j(error_hist[j].data(), error_hist[j].size());
                B(i,j) = err_i.dot(err_j);
                B(j,i) = B(i,j);
            }
            B(i,n) = -1.0; B(n,i) = -1.0;
        }
        B(n,n) = 0.0;
        
        Eigen::VectorXd rhs = Eigen::VectorXd::Zero(n+1);
        rhs(n) = -1.0;
        Eigen::VectorXd c = B.colPivHouseholderQr().solve(rhs);
        
        Eigen::Tensor<double, 4> ext(n1, n2, n3, n4);
        ext.setZero();
        Eigen::Map<Eigen::VectorXd> ext_map(ext.data(), ext.size());
        for (int i = 0; i < n; ++i) {
            Eigen::Map<const Eigen::VectorXd> t_map(tensor_hist[i].data(), tensor_hist[i].size());
            ext_map += c(i) * t_map;
        }
        return ext;
    }
};

void OMP3::solve_zvector() {
    if (na_ == 0 || va_ == 0) return;
    if (omp_get_thread_num() == 0) std::cout << "  [Z-Vector] Iteratively relaxing Lambda_2 amplitudes...\n";

    // ==========================================================
    // 1. INITIAL GUESS: 2.0 * T3 (Karena dE/dT = 2 * W)
    // ==========================================================
    L2_aa_ = Eigen::Tensor<double, 4>(na_, na_, va_, va_);
    for(int i=0; i<t2_3rd_aa_.size(); ++i) L2_aa_.data()[i] = 1.0 * t2_3rd_aa_.data()[i];
    
    if (nb_ > 0 && vb_ > 0) {
        L2_bb_ = Eigen::Tensor<double, 4>(nb_, nb_, vb_, vb_);
        for(int i=0; i<t2_3rd_bb_.size(); ++i) L2_bb_.data()[i] = 1.0 * t2_3rd_bb_.data()[i];
        
        L2_ab_ = Eigen::Tensor<double, 4>(na_, nb_, va_, vb_);
        for(int i=0; i<t2_3rd_ab_.size(); ++i) L2_ab_.data()[i] = 1.0 * t2_3rd_ab_.data()[i];
    }
    // ==========================================================

    int max_z_iter = 50;
    double z_thresh = 1e-7;
    double rms_error = 1.0;   
    int iter = 0;

    // Pra-Komputasi (Sama seperti sebelumnya)
    const auto& eri_ao = integrals_->compute_eri();
    const Eigen::MatrixXd& Cao = scf_.C_alpha.leftCols(na_);
    const Eigen::MatrixXd& Cav = scf_.C_alpha.rightCols(va_);
    const auto& ea = scf_.orbital_energies_alpha;

    auto V_VVVV_aa = ERITransformer::transform_vvvv(eri_ao, Cav, nbf_, va_);
    Eigen::MatrixXd packed_vvvv_aa = pack_ladder_vvvv_as(V_VVVV_aa, va_);
    auto V_OOOO_aa = ERITransformer::transform_oooo(eri_ao, Cao, nbf_, na_);
    Eigen::MatrixXd packed_oooo_aa = pack_ladder_oooo_as(V_OOOO_aa, na_);

    const auto& ovov_aa = workspace.get("ovov_aa");
    const auto& oovv_aa = workspace.get("oovv_aa");
    Eigen::MatrixXd V_AA(na_*va_, na_*va_);
    for(int ia=0; ia<na_*va_; ++ia) for(int kc=0; kc<na_*va_; ++kc) {
        int i=ia/va_; int a=ia%va_; int k=kc/va_; int c=kc%va_;
        V_AA(ia, kc) = ovov_aa(i,a,k,c) - oovv_aa(k,i,a,c);
    }

    Eigen::MatrixXd packed_vvvv_bb, packed_oooo_bb, V_BB;
    Eigen::MatrixXd V_cr_ab_aa, V_cr_ab_bb, V_AB_ring, V_AB_T4_ring, V_C1, V_C2;
    Eigen::Tensor<double, 4> Vv_ab, Vo_ab;
    
    if (nb_ > 0 && vb_ > 0) {
        const Eigen::MatrixXd& Cbo = scf_.C_beta.leftCols(nb_);
        const Eigen::MatrixXd& Cbv = scf_.C_beta.rightCols(vb_);
        const auto& eb = scf_.orbital_energies_beta;
        
        auto V_VVVV_bb = ERITransformer::transform_vvvv(eri_ao, Cbv, nbf_, vb_);
        packed_vvvv_bb = pack_ladder_vvvv_as(V_VVVV_bb, vb_);
        auto V_OOOO_bb = ERITransformer::transform_oooo(eri_ao, Cbo, nbf_, nb_);
        packed_oooo_bb = pack_ladder_oooo_as(V_OOOO_bb, nb_);

        const auto& ovov_bb = workspace.get("ovov_bb");
        const auto& oovv_bb = workspace.get("oovv_bb");
        V_BB = Eigen::MatrixXd::Zero(nb_*vb_, nb_*vb_);
        for(int ia=0; ia<nb_*vb_; ++ia) for(int kc=0; kc<nb_*vb_; ++kc) {
            int i=ia/vb_; int a=ia%vb_; int k=kc/vb_; int c=kc%vb_;
            V_BB(ia, kc) = ovov_bb(i,a,k,c) - oovv_bb(k,i,a,c);
        }

        const auto& g_ovov_ab = workspace.get("ovov_ab");
        V_cr_ab_aa = Eigen::MatrixXd::Zero(na_*va_, nb_*vb_);
        for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a)
            for(int k=0; k<nb_; ++k) for(int c=0; c<vb_; ++c)
                V_cr_ab_aa(i*va_+a, k*vb_+c) = g_ovov_ab(i,a,k,c);

        V_cr_ab_bb = Eigen::MatrixXd::Zero(nb_*vb_, na_*va_);
        for(int i=0; i<nb_; ++i) for(int a=0; a<vb_; ++a)
            for(int k=0; k<na_; ++k) for(int c=0; c<va_; ++c)
                V_cr_ab_bb(i*vb_+a, k*va_+c) = g_ovov_ab(k,c,i,a);

        Vv_ab = ERITransformer::transform_vvvv_mixed(eri_ao, Cav, Cbv, nbf_, va_, vb_);
        Vo_ab = ERITransformer::transform_oooo_mixed(eri_ao, Cao, Cbo, nbf_, na_, nb_);

        V_AB_ring = Eigen::MatrixXd::Zero(na_*va_, nb_*vb_);
        for(int k=0; k<na_; ++k) for(int c=0; c<va_; ++c) 
            for(int j=0; j<nb_; ++j) for(int b=0; b<vb_; ++b) 
                V_AB_ring(k*va_+c, j*vb_+b) = g_ovov_ab(k,c,j,b);
                
        V_AB_T4_ring = Eigen::MatrixXd::Zero(na_*va_, nb_*vb_);
        for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
            for(int k=0; k<nb_; ++k) for(int c=0; c<vb_; ++c) 
                V_AB_T4_ring(i*va_+a, k*vb_+c) = g_ovov_ab(i,a,k,c); 

        const auto& g_oovv_ab_ex = workspace.get("oovv_ab_ex");
        const auto& g_oovv_ba_ex = workspace.get("oovv_ba_ex");
        
        V_C1 = Eigen::MatrixXd::Zero(na_*vb_, na_*vb_);
        for(int i=0; i<na_; ++i) for(int b=0; b<vb_; ++b) 
            for(int k=0; k<na_; ++k) for(int c=0; c<vb_; ++c) 
                V_C1(i*vb_+b, k*vb_+c) = g_oovv_ab_ex(i,k,b,c);
                
        V_C2 = Eigen::MatrixXd::Zero(nb_*va_, nb_*va_);
        for(int j=0; j<nb_; ++j) for(int a=0; a<va_; ++a) 
            for(int k=0; k<nb_; ++k) for(int c=0; c<va_; ++c) 
                V_C2(j*va_+a, k*va_+c) = g_oovv_ba_ex(j,k,a,c);
    }

    ZDIIS_Tensor diis_aa, diis_bb, diis_ab;

    auto unpack_ijab_to_iajb = [](const Eigen::MatrixXd& W_ijab, Eigen::MatrixXd& W_iajb, int no, int nv) {
        #pragma omp parallel for collapse(2)
        for(int i = 0; i < no; ++i) {
            for(int j = 0; j < no; ++j) {
                for(int a = 0; a < nv; ++a) {
                    for(int b = 0; b < nv; ++b) {
                        W_iajb(i*nv + a, j*nv + b) += W_ijab(i*no + j, a*nv + b);
                    }
                }
            }
        }
    };

    // ==========================================================
    // LOOP Z-VECTOR 
    // ==========================================================
    while (rms_error > z_thresh && iter < max_z_iter) {
        rms_error = 0.0;
        int total_elements = na_*na_*va_*va_;
        
        Eigen::Tensor<double, 4> R_aa(na_, na_, va_, va_); R_aa.setZero();
        Eigen::Tensor<double, 4> R_bb, R_ab;

        // --- AA CHANNEL JACOBIAN ---
        Eigen::MatrixXd W_res_AA = Eigen::MatrixXd::Zero(na_*va_, na_*va_);
        Eigen::MatrixXd L2_mat_aa = pack_t2_ij_ab(L2_aa_, na_, va_);
        Eigen::MatrixXd W_ijab_aa = 0.5 * (L2_mat_aa * packed_vvvv_aa) + 0.5 * (packed_oooo_aa.transpose() * L2_mat_aa);
        unpack_ijab_to_iajb(W_ijab_aa, W_res_AA, na_, va_);

        Eigen::MatrixXd L2_iajb_AA(na_*va_, na_*va_);
        for(int ia=0; ia<na_*va_; ++ia) for(int jb=0; jb<na_*va_; ++jb) {
            int i=ia/va_; int a=ia%va_; int j=jb/va_; int b=jb%va_;
            L2_iajb_AA(ia, jb) = L2_aa_(i,j,a,b);
        }
        
        Eigen::MatrixXd Z_Ring_raw_AA = V_AA * L2_iajb_AA;

        if (nb_ > 0 && vb_ > 0) {
            Eigen::MatrixXd L2_cr_ab(nb_*vb_, na_*va_);
            for (int k=0; k<nb_; ++k) for (int c=0; c<vb_; ++c)
                for (int j=0; j<na_; ++j) for (int b=0; b<va_; ++b)
                    L2_cr_ab(k*vb_+c, j*va_+b) = L2_ab_(j,k,b,c);
                    
            Z_Ring_raw_AA += V_cr_ab_aa * L2_cr_ab;
        }

        #pragma omp parallel for collapse(2)
        for(int i=0; i<na_; ++i) {
            for(int j=0; j<na_; ++j) {
                for(int a=0; a<va_; ++a) {
                    for(int b=0; b<va_; ++b) {
                        W_res_AA(i*va_+a, j*va_+b) += 
                              Z_Ring_raw_AA(i*va_+a, j*va_+b) 
                            - Z_Ring_raw_AA(j*va_+a, i*va_+b) 
                            - Z_Ring_raw_AA(i*va_+b, j*va_+a) 
                            + Z_Ring_raw_AA(j*va_+b, i*va_+a);
                    }
                }
            }
        }

        // 1. UPDATE AA MENGGUNAKAN TENSOR SEMENTARA (L2_next)
        Eigen::Tensor<double, 4> L2_next_aa(na_, na_, va_, va_);
        for(int ia=0; ia<na_*va_; ++ia) for(int jb=0; jb<na_*va_; ++jb) {
            int i=ia/va_; int a=ia%va_; int j=jb/va_; int b=jb%va_;
            double D = ea(i) + ea(j) - ea(na_+a) - ea(na_+b);
            double L2_new = 1.0 * t2_3rd_aa_(i,j,a,b);
            if (std::abs(D) > 1e-12) L2_new -= W_res_AA(ia, jb) / D;
            
            L2_next_aa(i,j,a,b) = L2_new; // SIMPAN KE TENSOR BARU
            
            double err = L2_new - L2_aa_(i,j,a,b);
            R_aa(i,j,a,b) = err;
            rms_error += err * err;
        }

        // --- BB & AB CHANNELS JACOBIAN ---
        Eigen::Tensor<double, 4> L2_next_bb, L2_next_ab; // DEKLARASI DI SINI
        if (nb_ > 0 && vb_ > 0) {
            const auto& eb = scf_.orbital_energies_beta;
            R_bb = Eigen::Tensor<double, 4>(nb_, nb_, vb_, vb_); R_bb.setZero();
            R_ab = Eigen::Tensor<double, 4>(na_, nb_, va_, vb_); R_ab.setZero();
            L2_next_bb = Eigen::Tensor<double, 4>(nb_, nb_, vb_, vb_); // ALOKASI
            L2_next_ab = Eigen::Tensor<double, 4>(na_, nb_, va_, vb_); // ALOKASI
            total_elements += (nb_*nb_*vb_*vb_) + (na_*nb_*va_*vb_);

            Eigen::MatrixXd W_res_BB = Eigen::MatrixXd::Zero(nb_*vb_, nb_*vb_);
            Eigen::MatrixXd L2_mat_bb = pack_t2_ij_ab(L2_bb_, nb_, vb_);
            Eigen::MatrixXd W_ijab_bb = 0.5 * (L2_mat_bb * packed_vvvv_bb) + 0.5 * (packed_oooo_bb.transpose() * L2_mat_bb);
            unpack_ijab_to_iajb(W_ijab_bb, W_res_BB, nb_, vb_);

            Eigen::MatrixXd L2_iajb_BB(nb_*vb_, nb_*vb_);
            for(int ia=0; ia<nb_*vb_; ++ia) for(int jb=0; jb<nb_*vb_; ++jb) {
                int i=ia/vb_; int a=ia%vb_; int j=jb/vb_; int b=jb%vb_;
                L2_iajb_BB(ia, jb) = L2_bb_(i,j,a,b);
            }
            
            Eigen::MatrixXd Z_Ring_raw_BB = V_BB * L2_iajb_BB;

            Eigen::MatrixXd L2_cr_ba(na_*va_, nb_*vb_);
            for (int k=0; k<na_; ++k) for (int c=0; c<va_; ++c)
                for (int j=0; j<nb_; ++j) for (int b=0; b<vb_; ++b)
                    L2_cr_ba(k*va_+c, j*vb_+b) = L2_ab_(k,j,c,b);
                    
            Z_Ring_raw_BB += V_cr_ab_bb * L2_cr_ba;

            #pragma omp parallel for collapse(2)
            for(int i=0; i<nb_; ++i) {
                for(int j=0; j<nb_; ++j) {
                    for(int a=0; a<vb_; ++a) {
                        for(int b=0; b<vb_; ++b) {
                            W_res_BB(i*vb_+a, j*vb_+b) += 
                                Z_Ring_raw_BB(i*vb_+a, j*vb_+b) 
                                - Z_Ring_raw_BB(j*vb_+a, i*vb_+b) 
                                - Z_Ring_raw_BB(i*vb_+b, j*vb_+a) 
                                + Z_Ring_raw_BB(j*vb_+b, i*vb_+a);
                        }
                    }
                }
            }
            // 2. UPDATE BB MENGGUNAKAN TENSOR SEMENTARA
            for(int ia=0; ia<nb_*vb_; ++ia) for(int jb=0; jb<nb_*vb_; ++jb) {
                int i=ia/vb_; int a=ia%vb_; int j=jb/vb_; int b=jb%vb_;
                double D = eb(i) + eb(j) - eb(nb_+a) - eb(nb_+b);
                double L2_new = 1.0 * t2_3rd_bb_(i,j,a,b);
                if (std::abs(D) > 1e-12) L2_new -= W_res_BB(ia, jb) / D;
                
                L2_next_bb(i,j,a,b) = L2_new; // SIMPAN KE TENSOR BARU
                
                double err = L2_new - L2_bb_(i,j,a,b);
                R_bb(i,j,a,b) = err;
                rms_error += err * err;
            }

            // AB Channel
            Eigen::MatrixXd W_res_AB = Eigen::MatrixXd::Zero(na_*va_, nb_*vb_);
            
            #pragma omp parallel for collapse(2)
            for(int i=0; i<na_; ++i) for(int j=0; j<nb_; ++j) {
                for(int a=0; a<va_; ++a) for(int b=0; b<vb_; ++b) {
                    double sum = 0;
                    for(int c=0; c<va_; ++c) for(int d=0; d<vb_; ++d) sum += Vv_ab(a,c,b,d) * L2_ab_(i,j,c,d);
                    for(int k=0; k<na_; ++k) for(int l=0; l<nb_; ++l) sum += Vo_ab(k,i,l,j) * L2_ab_(k,l,a,b);
                    W_res_AB(i*va_+a, j*vb_+b) += sum;
                }
            }

            Eigen::MatrixXd L2_iajb_AB(na_*va_, nb_*vb_);
            for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
                for(int j=0; j<nb_; ++j) for(int b=0; b<vb_; ++b) 
                    L2_iajb_AB(i*va_+a, j*vb_+b) = L2_ab_(i,j,a,b);
                    
            W_res_AB += V_AA * L2_iajb_AB;
            
            Eigen::MatrixXd L2_AB_ik(na_*va_, nb_*vb_);
            for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
                for(int k=0; k<nb_; ++k) for(int c=0; c<vb_; ++c) 
                    L2_AB_ik(i*va_+a, k*vb_+c) = L2_ab_(i,k,a,c);
            W_res_AB += L2_AB_ik * V_BB;
            
            Eigen::MatrixXd L2_AA_mat(na_*va_, na_*va_);
            for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
                for(int k=0; k<na_; ++k) for(int c=0; c<va_; ++c) 
                    L2_AA_mat(i*va_+a, k*va_+c) = L2_aa_(i,k,a,c);
            W_res_AB += L2_AA_mat * V_AB_ring;

            Eigen::MatrixXd L2_BB_mat(nb_*vb_, nb_*vb_);
            for(int k=0; k<nb_; ++k) for(int c=0; c<vb_; ++c) 
                for(int j=0; j<nb_; ++j) for(int b=0; b<vb_; ++b) 
                    L2_BB_mat(k*vb_+c, j*vb_+b) = L2_bb_(k,j,c,b);
            W_res_AB += V_AB_T4_ring * L2_BB_mat;
            
            Eigen::MatrixXd L2_C1(na_*vb_, nb_*va_);
            for(int k=0; k<na_; ++k) for(int c=0; c<vb_; ++c) 
                for(int j=0; j<nb_; ++j) for(int a=0; a<va_; ++a) 
                    L2_C1(k*vb_+c, j*va_+a) = L2_ab_(k,j,a,c);
            Eigen::MatrixXd W_C1 = V_C1 * L2_C1;
            for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
                for(int j=0; j<nb_; ++j) for(int b=0; b<vb_; ++b) 
                    W_res_AB(i*va_+a, j*vb_+b) -= W_C1(i*vb_+b, j*va_+a);

            Eigen::MatrixXd L2_C2(nb_*va_, na_*vb_);
            for(int k=0; k<nb_; ++k) for(int c=0; c<va_; ++c) 
                for(int i=0; i<na_; ++i) for(int b=0; b<vb_; ++b) 
                    L2_C2(k*va_+c, i*vb_+b) = L2_ab_(i,k,c,b);
            Eigen::MatrixXd W_C2 = V_C2 * L2_C2;
            for(int i=0; i<na_; ++i) for(int a=0; a<va_; ++a) 
                for(int j=0; j<nb_; ++j) for(int b=0; b<vb_; ++b) 
                    W_res_AB(i*va_+a, j*vb_+b) -= W_C2(j*va_+a, i*vb_+b);

            // 3. UPDATE AB MENGGUNAKAN TENSOR SEMENTARA
            for(int ia=0; ia<na_*va_; ++ia) for(int jb=0; jb<nb_*vb_; ++jb) {
                int i=ia/va_; int a=ia%va_; int j=jb/vb_; int b=jb%vb_;
                double D = ea(i) + eb(j) - ea(na_+a) - eb(nb_+b);
                double L2_new = 1.0 * t2_3rd_ab_(i,j,a,b);
                if (std::abs(D) > 1e-12) L2_new -= W_res_AB(ia, jb) / D;
                
                L2_next_ab(i,j,a,b) = L2_new; // SIMPAN KE TENSOR BARU
                
                double err = L2_new - L2_ab_(i,j,a,b);
                R_ab(i,j,a,b) = err;
                rms_error += err * err;
            }
        }

        rms_error = std::sqrt(rms_error / total_elements);

        if (omp_get_thread_num() == 0) {
            std::cout << "    Z-Iter " << std::setw(2) << iter + 1 
                      << " | RMS Error: " << std::scientific << rms_error << "\n";
        }

        if (rms_error < z_thresh) {
            if (omp_get_thread_num() == 0) std::cout << "  [Z-Vector] Converged in " << iter+1 << " steps.\n";
            break;
        }

        // 4. PUSH L2_NEXT (HASIL UPDATE BARU) KE DALAM DIIS
        diis_aa.push(L2_next_aa, R_aa);
        L2_aa_ = diis_aa.extrapolate(na_, na_, va_, va_);
        
        if (nb_ > 0 && vb_ > 0) {
            diis_bb.push(L2_next_bb, R_bb);
            L2_bb_ = diis_bb.extrapolate(nb_, nb_, vb_, vb_);
            
            diis_ab.push(L2_next_ab, R_ab);
            L2_ab_ = diis_ab.extrapolate(na_, nb_, va_, vb_);
        }

        iter++;
    }

    if (iter == max_z_iter && omp_get_thread_num() == 0) {
        std::cout << "  [WARNING] Z-Vector reached max iterations without fully converging. RMS: " << rms_error << "\n";
    }
}


struct KappaDIIS {
    std::vector<Eigen::MatrixXd> kappa_hist;  // history rotasi
    std::vector<Eigen::MatrixXd> grad_hist;   // history gradient (error)
    int max_vec = 6;
    
    void push(const Eigen::MatrixXd& kappa, const Eigen::MatrixXd& grad) {
        kappa_hist.push_back(kappa);
        grad_hist.push_back(grad);
        if ((int)kappa_hist.size() > max_vec) {
            kappa_hist.erase(kappa_hist.begin());
            grad_hist.erase(grad_hist.begin());
        }
    }
    
    Eigen::MatrixXd extrapolate() {
        int n = kappa_hist.size();
        if (n < 2) return kappa_hist.back();
        
        // Bangun matriks B (inner product error vectors)
        Eigen::MatrixXd B = Eigen::MatrixXd::Zero(n+1, n+1);
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j <= i; ++j) {
                B(i,j) = grad_hist[i].cwiseProduct(grad_hist[j]).sum();
                B(j,i) = B(i,j);
            }
            B(i,n) = -1.0;
            B(n,i) = -1.0;
        }
        B(n,n) = 0.0;
        
        Eigen::VectorXd rhs = Eigen::VectorXd::Zero(n+1);
        rhs(n) = -1.0;
        
        Eigen::VectorXd coeffs = B.colPivHouseholderQr().solve(rhs);
        
        Eigen::MatrixXd kappa_extrap = Eigen::MatrixXd::Zero(kappa_hist[0].rows(), kappa_hist[0].cols());
        for (int i = 0; i < n; ++i) {
            kappa_extrap += coeffs(i) * kappa_hist[i];
        }
        return kappa_extrap;
    }
};



// ============================================================================
// OPDM FORMATION (MP2 + MP3) - EXACT 3RD ORDER TRUNCATION (MURNI)
// ============================================================================
void OMP3::build_opdm_alpha() {
    G_oo_alpha_ = Eigen::MatrixXd::Zero(na_, na_);
    G_vv_alpha_ = Eigen::MatrixXd::Zero(va_, va_);
    long va2 = va_ * va_;

    // --- BLOCK OCCUPIED-OCCUPIED (ALPHA) ---
    Eigen::MatrixXd T1_AA_o(na_, na_ * va2), T2_AA_o(na_, na_ * va2);
    for(int i=0; i<na_; ++i) for(int k=0; k<na_; ++k) for(int ab=0; ab<va2; ++ab) {
        int a = ab/va_; int b = ab%va_;
        T1_AA_o(i, k*va2+ab) = t2_aa_(i, k, a, b);
        T2_AA_o(i, k*va2+ab) = L2_aa_(i, k, a, b);
    }
    // Term MP2 Murni: T1 * T1
    G_oo_alpha_ = -0.5 * (T1_AA_o * T1_AA_o.transpose());
    // Term MP3 Murni: T1 * T2 + T2 * T1
    G_oo_alpha_ -= 0.5 * (T1_AA_o * T2_AA_o.transpose() + T2_AA_o * T1_AA_o.transpose());

    if (nb_ > 0 && vb_ > 0) {
        Eigen::MatrixXd T1_AB_o(na_, nb_ * va_ * vb_), T2_AB_o(na_, nb_ * va_ * vb_);
        for(int i=0; i<na_; ++i) for(int k=0; k<nb_; ++k) for(int a=0; a<va_; ++a) for(int b=0; b<vb_; ++b) {
            int col = k*(va_*vb_) + a*vb_ + b;
            T1_AB_o(i, col) = t2_ab_(i, k, a, b);
            T2_AB_o(i, col) = L2_ab_(i, k, a, b);
        }
        // Term MP2 Murni (AB)
        G_oo_alpha_ -= 1.0 * (T1_AB_o * T1_AB_o.transpose());
        // Term MP3 Murni (AB)
        G_oo_alpha_ -= 1.0 * (T1_AB_o * T2_AB_o.transpose() + T2_AB_o * T1_AB_o.transpose());
    }

    // --- BLOCK VIRTUAL-VIRTUAL (ALPHA) ---
    Eigen::MatrixXd T1_AA_v(va_, na_ * na_ * va_), T2_AA_v(va_, na_ * na_ * va_);
    for(int a=0; a<va_; ++a) {
        int col = 0;
        for(int i=0; i<na_; ++i) for(int j=0; j<na_; ++j) for(int c=0; c<va_; ++c) {
            T1_AA_v(a, col) = t2_aa_(i, j, a, c);
            T2_AA_v(a, col) = L2_aa_(i, j, a, c); col++;
        }
    }
    // Term MP2 Murni: T1 * T1
    G_vv_alpha_ = 0.5 * (T1_AA_v * T1_AA_v.transpose());
    // Term MP3 Murni: T1 * T2 + T2 * T1
    G_vv_alpha_ += 0.5 * (T1_AA_v * T2_AA_v.transpose() + T2_AA_v * T1_AA_v.transpose());

    if (nb_ > 0 && vb_ > 0) {
        Eigen::MatrixXd T1_AB_v(va_, na_ * nb_ * vb_), T2_AB_v(va_, na_ * nb_ * vb_);
        for(int a=0; a<va_; ++a) {
            int col = 0;
            for(int i=0; i<na_; ++i) for(int j=0; j<nb_; ++j) for(int c=0; c<vb_; ++c) {
                T1_AB_v(a, col) = t2_ab_(i, j, a, c);
                T2_AB_v(a, col) = L2_ab_(i, j, a, c); col++;
            }
        }
        // Term MP2 Murni (AB)
        G_vv_alpha_ += 1.0 * (T1_AB_v * T1_AB_v.transpose());
        // Term MP3 Murni (AB)
        G_vv_alpha_ += 1.0 * (T1_AB_v * T2_AB_v.transpose() + T2_AB_v * T1_AB_v.transpose());
    }
}

void OMP3::build_opdm_beta() {
    G_oo_beta_ = Eigen::MatrixXd::Zero(nb_, nb_);
    G_vv_beta_ = Eigen::MatrixXd::Zero(vb_, vb_);
    if (nb_ == 0 || vb_ == 0) return;
    long vb2 = vb_ * vb_;

    // --- BLOCK OCCUPIED-OCCUPIED (BETA) ---
    Eigen::MatrixXd T1_BB_o(nb_, nb_ * vb2), T2_BB_o(nb_, nb_ * vb2);
    for(int i=0; i<nb_; ++i) for(int k=0; k<nb_; ++k) for(int ab=0; ab<vb2; ++ab) {
        int a = ab/vb_; int b = ab%vb_;
        T1_BB_o(i, k*vb2+ab) = t2_bb_(i, k, a, b);
        T2_BB_o(i, k*vb2+ab) = L2_bb_(i, k, a, b);
    }
    // Term MP2 Murni
    G_oo_beta_ = -0.5 * (T1_BB_o * T1_BB_o.transpose());
    // Term MP3 Murni
    G_oo_beta_ -= 0.5 * (T1_BB_o * T2_BB_o.transpose() + T2_BB_o * T1_BB_o.transpose());

    Eigen::MatrixXd T1_BA_o(nb_, na_ * va_ * vb_), T2_BA_o(nb_, na_ * va_ * vb_);
    for(int i=0; i<nb_; ++i) for(int k=0; k<na_; ++k) for(int a=0; a<va_; ++a) for(int b=0; b<vb_; ++b) {
        int col = k*(va_*vb_) + a*vb_ + b;
        T1_BA_o(i, col) = t2_ab_(k, i, a, b);
        T2_BA_o(i, col) = L2_ab_(k, i, a, b);
    }
    // Term MP2 Murni (BA)
    G_oo_beta_ -= 1.0 * (T1_BA_o * T1_BA_o.transpose());
    // Term MP3 Murni (BA)
    G_oo_beta_ -= 1.0 * (T1_BA_o * T2_BA_o.transpose() + T2_BA_o * T1_BA_o.transpose());

    // --- BLOCK VIRTUAL-VIRTUAL (BETA) ---
    Eigen::MatrixXd T1_BB_v(vb_, nb_ * nb_ * vb_), T2_BB_v(vb_, nb_ * nb_ * vb_);
    for(int a=0; a<vb_; ++a) {
        int col = 0;
        for(int i=0; i<nb_; ++i) for(int j=0; j<nb_; ++j) for(int c=0; c<vb_; ++c) {
            T1_BB_v(a, col) = t2_bb_(i, j, a, c);
            T2_BB_v(a, col) = L2_bb_(i, j, a, c); col++;
        }
    }
    // Term MP2 Murni
    G_vv_beta_ = 0.5 * (T1_BB_v * T1_BB_v.transpose());
    // Term MP3 Murni
    G_vv_beta_ += 0.5 * (T1_BB_v * T2_BB_v.transpose() + T2_BB_v * T1_BB_v.transpose());

    Eigen::MatrixXd T1_BA_v(vb_, na_ * nb_ * va_), T2_BA_v(vb_, na_ * nb_ * va_);
    for(int a=0; a<vb_; ++a) {
        int col = 0;
        for(int i=0; i<na_; ++i) for(int j=0; j<nb_; ++j) for(int c=0; c<va_; ++c) {
            T1_BA_v(a, col) = t2_ab_(i, j, c, a);
            T2_BA_v(a, col) = L2_ab_(i, j, c, a); col++;
        }
    }
    // Term MP2 Murni (BA)
    G_vv_beta_ += 1.0 * (T1_BA_v * T1_BA_v.transpose());
    // Term MP3 Murni (BA)
    G_vv_beta_ += 1.0 * (T1_BA_v * T2_BA_v.transpose() + T2_BA_v * T1_BA_v.transpose());
}

// ============================================================================
// MAIN COMPUTE LOOP (ITERATIVE OMP3)
// ============================================================================
OMP3Result OMP3::compute() {
    std::string mode = (na_ == nb_) ? "R" : "U";
    if(omp_get_thread_num() == 0) {
        std::cout << "\n========================================\n";
        std::cout << "  Iterative 2-RDM MP3 (" << mode << "-OMP3)   \n";
        std::cout << "========================================\n";
        std::cout << "Iter    E_Total (Ha)    E_Corr (Ha)     ||Grad||    Step\n";
        std::cout << "--------------------------------------------------------\n";
    }

    Eigen::MatrixXd C_a_last = scf_.C_alpha;
    Eigen::MatrixXd C_b_last = scf_.C_beta;
    Eigen::MatrixXd K_dir_a_last = Eigen::MatrixXd::Zero(nbf_, nbf_);
    Eigen::MatrixXd K_dir_b_last = Eigen::MatrixXd::Zero(nbf_, nbf_);

    double current_step = 0.5; 
    int iter = 0;
    bool is_converged = false;

    // INISIALISASI VARIABEL TRACKING DI LUAR LOOP
    Eigen::MatrixXd C_a_backup = scf_.C_alpha;
    Eigen::MatrixXd C_b_backup = scf_.C_beta;
    double e_total_best = 1e99; 
    double e_total_last = 1e99;
    double e_corr_last = 0.0;
    double min_step_size = 1e-3;
    double grad_norm_last = 1.0;

    auto rotate_orbitals = [&](double scale, const Eigen::MatrixXd& Kdir_a, const Eigen::MatrixXd& Kdir_b) {
        Eigen::MatrixXd Ka = Kdir_a * scale; Eigen::MatrixXd Kb = Kdir_b * scale;
        for(int i=0; i<Ka.size(); ++i) {
            if (Ka(i) > 0.4) Ka(i) = 0.4; if (Ka(i) < -0.4) Ka(i) = -0.4;
            if (Kb(i) > 0.4) Kb(i) = 0.4; if (Kb(i) < -0.4) Kb(i) = -0.4;
        }
        scf_.C_alpha = C_a_last * (-Ka).exp();
        scf_.C_beta = (mode == "U") ? C_b_last * (-Kb).exp() : scf_.C_alpha;
        scf_.P_alpha = scf_.C_alpha.leftCols(na_) * scf_.C_alpha.leftCols(na_).transpose();
        scf_.P_beta  = scf_.C_beta.leftCols(nb_)  * scf_.C_beta.leftCols(nb_).transpose();
    };

    
    

    KappaDIIS diis_kappa_a;
    KappaDIIS diis_kappa_b;

    // Deklarasi Matriks Gradien di luar loop agar tidak membebani alokator RAM
    Eigen::MatrixXd V_a_jbc, T_i_jbc, V_i_jkb, T_a_jkb;
    Eigen::MatrixXd V_a_jbc_ab, T_i_jbc_ab, V_i_jkb_ab, T_a_jkb_ab;
    
    if (na_ >= 2 && va_ >= 2) {
        V_a_jbc.resize(va_, na_*va_*va_); T_i_jbc.resize(na_, na_*va_*va_);
        V_i_jkb.resize(na_, na_*na_*va_); T_a_jkb.resize(va_, na_*na_*va_);
    }
    if (nb_ > 0 && vb_ > 0) {
        V_a_jbc_ab.resize(va_, nb_*va_*vb_); T_i_jbc_ab.resize(na_, nb_*va_*vb_);
        V_i_jkb_ab.resize(na_, nb_*na_*vb_); T_a_jkb_ab.resize(va_, nb_*na_*vb_);
    }

    Eigen::MatrixXd V_a_jbc_b, T_i_jbc_b, V_i_jkb_b, T_a_jkb_b;
    Eigen::MatrixXd V_a_jbc_ba, T_i_jbc_ba, V_i_jkb_ba, T_a_jkb_ba;

    if (nb_ >= 2 && vb_ >= 2) {
        V_a_jbc_b.resize(vb_, nb_*vb_*vb_); T_i_jbc_b.resize(nb_, nb_*vb_*vb_);
        V_i_jkb_b.resize(nb_, nb_*nb_*vb_); T_a_jkb_b.resize(vb_, nb_*nb_*vb_);
    }
    if (na_ > 0 && va_ > 0 && nb_ > 0 && vb_ > 0) { // BA channel
        V_a_jbc_ba.resize(vb_, na_*vb_*va_); T_i_jbc_ba.resize(nb_, na_*vb_*va_);
        V_i_jkb_ba.resize(nb_, na_*nb_*va_); T_a_jkb_ba.resize(vb_, na_*nb_*va_);
    }

    while(iter < max_iter_) {
        pseudocanonicalize();
        double e_mp2 = compute_mp2_energy();
        double e_mp3 = compute_mp3_correction();

        solve_zvector();
        
        Eigen::MatrixXd F_ao_a, F_ao_b;
        build_fock_fast(scf_.P_alpha, scf_.P_beta, F_ao_a, F_ao_b);

        if (symmetrizer_) {
            symmetrizer_->symmetrize(F_ao_a);
            symmetrizer_->symmetrize(F_ao_b);
        }
        
        double e_scf = 0.5 * (scf_.P_alpha.cwiseProduct(integrals_->compute_core_hamiltonian() + F_ao_a).sum() + 
                              scf_.P_beta.cwiseProduct(integrals_->compute_core_hamiltonian() + F_ao_b).sum()) 
                       + mol_.nuclear_repulsion_energy();
        
        double e_corr = e_mp2 + e_mp3;
        double e_tot = e_scf + e_corr;
            
        double dE = (iter == 0) ? 1.0 : std::abs(e_total_last - e_tot); 
        
        // Hanya simpan energi dan koefisien untuk pencatatan
        if (e_tot < e_total_best) {
            e_total_best = e_tot;
            C_a_backup = scf_.C_alpha;
            C_b_backup = scf_.C_beta;
        }
        
        e_total_last = e_tot;
        e_corr_last = e_corr;
        C_a_last = scf_.C_alpha; 
        C_b_last = scf_.C_beta;
        // 1. BANGUN OPDM
        build_opdm_alpha();
        build_opdm_beta();

        Eigen::MatrixXd G_full_a = Eigen::MatrixXd::Zero(nbf_, nbf_);
        G_full_a.block(0,0,na_,na_) = G_oo_alpha_; 
        G_full_a.block(na_,na_,va_,va_) = G_vv_alpha_;
        Eigen::MatrixXd P_corr_a = scf_.C_alpha * G_full_a * scf_.C_alpha.transpose();
        
        Eigen::MatrixXd G_full_b = Eigen::MatrixXd::Zero(nbf_, nbf_);
        if (nb_ > 0) {
            G_full_b.block(0,0,nb_,nb_) = G_oo_beta_; 
            G_full_b.block(nb_,nb_,vb_,vb_) = G_vv_beta_;
        }
        Eigen::MatrixXd P_corr_b = scf_.C_beta * G_full_b * scf_.C_beta.transpose();

        // 2. BANGUN FOCK MATRIX
        Eigen::MatrixXd F_gen_a, F_gen_b;
        build_fock_fast(scf_.P_alpha + P_corr_a, scf_.P_beta + P_corr_b, F_gen_a, F_gen_b);

        if (symmetrizer_) {
            symmetrizer_->symmetrize(F_gen_a);
            symmetrizer_->symmetrize(F_gen_b);
        }

        Eigen::MatrixXd F_mo_a = scf_.C_alpha.transpose() * F_gen_a * scf_.C_alpha;
        Eigen::MatrixXd F_mo_b = Eigen::MatrixXd::Zero(nbf_, nbf_);
        if (nb_ > 0) F_mo_b = scf_.C_beta.transpose() * F_gen_b * scf_.C_beta;

        // ====================================================================
        // 3. EXACT 2-RDM NON-SEPARABLE GRADIENT (100% BOUNDS-SAFE)
        // ====================================================================

        // --- A. GRADIENT UNTUK ALPHA ---
        if (na_ > 0 && va_ > 0) {
            Eigen::MatrixXd L_nonsep_a = Eigen::MatrixXd::Zero(va_, na_);
            const Eigen::MatrixXd& Cao = scf_.C_alpha.leftCols(na_);
            const Eigen::MatrixXd& Cav = scf_.C_alpha.rightCols(va_);
            
            // 1. AA Channel
            if (na_ >= 2 && va_ >= 2) {
                // OPTIMASI: Gunakan transform_oovv_mixed (DGEMM) menggantikan transform_custom yang lambat!
                auto V_vovv_aa = ERITransformer::transform_oovv_mixed(integrals_->compute_eri(), Cav, Cao, Cav, Cav, nbf_, va_, na_, va_, va_);
                auto V_ooov_aa = ERITransformer::transform_oovv_mixed(integrals_->compute_eri(), Cao, Cao, Cao, Cav, nbf_, na_, na_, na_, va_);
                
                #pragma omp parallel
                {
                    #pragma omp for collapse(3) nowait
                    for(int j=0; j<na_; ++j) for(int b=0; b<va_; ++b) for(int c=0; c<va_; ++c) {
                        int col = j*va_*va_ + b*va_ + c;
                        // Perhatikan indeks V_vovv_aa menjadi (a, b, j, c)
                        for(int a=0; a<va_; ++a) V_a_jbc(a, col) = V_vovv_aa(a,b,j,c);
                        
                        // Gabungkan T2 dan L2 secara langsung
                        for(int i=0; i<na_; ++i) T_i_jbc(i, col) = t2_aa_(i,j,b,c) + L2_aa_(i,j,b,c);
                    }
                    #pragma omp for collapse(3)
                    for(int j=0; j<na_; ++j) for(int k=0; k<na_; ++k) for(int b=0; b<va_; ++b) {
                        int col = j*na_*va_ + k*va_ + b;
                        for(int i=0; i<na_; ++i) V_i_jkb(i, col) = V_ooov_aa(j,i,k,b);
                        
                        for(int a=0; a<va_; ++a) T_a_jkb(a, col) = t2_aa_(j,k,a,b) + L2_aa_(j,k,a,b);
                    }
                }
                // PERKALIAN BLAS LEVEL 3 YANG SANGAT CEPAT
                L_nonsep_a += 0.5 * (V_a_jbc * T_i_jbc.transpose() - T_a_jkb * V_i_jkb.transpose());
                
            }

            // 2. AB Channel untuk Alpha
            if (nb_ > 0 && vb_ > 0) {
                const Eigen::MatrixXd& Cbo = scf_.C_beta.leftCols(nb_);
                const Eigen::MatrixXd& Cbv = scf_.C_beta.rightCols(vb_);

                // OPTIMASI: Gunakan transform_oovv_mixed (DGEMM) 
                auto V_vovv_ab = ERITransformer::transform_oovv_mixed(integrals_->compute_eri(), Cav, Cbo, Cav, Cbv, nbf_, va_, nb_, va_, vb_);
                auto V_ooov_ab = ERITransformer::transform_oovv_mixed(integrals_->compute_eri(), Cao, Cbo, Cao, Cbv, nbf_, na_, nb_, na_, vb_);

                #pragma omp parallel
                {
                    #pragma omp for collapse(3) nowait
                    for(int j=0; j<nb_; ++j) for(int b=0; b<va_; ++b) for(int c=0; c<vb_; ++c) {
                        int col = j*va_*vb_ + b*vb_ + c;
                        // Perhatikan indeks V_vovv_ab menjadi (a, j, b, c)
                        for(int a=0; a<va_; ++a) V_a_jbc_ab(a, col) = V_vovv_ab(a,b,j,c);
                        
                        for(int i=0; i<na_; ++i) T_i_jbc_ab(i, col) = t2_ab_(i,j,b,c) + L2_ab_(i,j,b,c);
                    }
                    #pragma omp for collapse(3)
                    for(int j=0; j<nb_; ++j) for(int k=0; k<na_; ++k) for(int b=0; b<vb_; ++b) {
                        int col = j*na_*vb_ + k*vb_ + b;
                        // Indeks ooov_ab untuk AB adalah (k, i, j, b)
                        for(int i=0; i<na_; ++i) V_i_jkb_ab(i, col) = V_ooov_ab(k,i,j,b);
                        
                        for(int a=0; a<va_; ++a) T_a_jkb_ab(a, col) = t2_ab_(k,j,a,b) + L2_ab_(k,j,a,b);
                    }
                }
                // PERKALIAN BLAS LEVEL 3
                L_nonsep_a += 1.0 * (V_a_jbc_ab * T_i_jbc_ab.transpose() - T_a_jkb_ab * V_i_jkb_ab.transpose());             
            }
               

            Eigen::MatrixXd F_vo_a = F_mo_a.block(na_, 0, va_, na_);
            Eigen::MatrixXd L_total_a = (G_vv_alpha_ * F_vo_a - F_vo_a * G_oo_alpha_) + L_nonsep_a;
            F_mo_a.block(na_, 0, va_, na_) += L_total_a;
            F_mo_a.block(0, na_, na_, va_) += L_total_a.transpose();
        }

        // --- B. GRADIENT UNTUK BETA ---
        if (nb_ > 0 && vb_ > 0) {
            Eigen::MatrixXd L_nonsep_b = Eigen::MatrixXd::Zero(vb_, nb_);
            const Eigen::MatrixXd& Cao = scf_.C_alpha.leftCols(na_);
            const Eigen::MatrixXd& Cav = scf_.C_alpha.rightCols(va_);
            const Eigen::MatrixXd& Cbo = scf_.C_beta.leftCols(nb_);
            const Eigen::MatrixXd& Cbv = scf_.C_beta.rightCols(vb_);
            
            // 1. BB Channel
            if (nb_ >= 2 && vb_ >= 2) {
                // OPTIMASI: Ganti transform_custom dengan transform_oovv_mixed (DGEMM)
                auto V_vovv_bb = ERITransformer::transform_oovv_mixed(integrals_->compute_eri(), Cbv, Cbo, Cbv, Cbv, nbf_, vb_, nb_, vb_, vb_);
                auto V_ooov_bb = ERITransformer::transform_oovv_mixed(integrals_->compute_eri(), Cbo, Cbo, Cbo, Cbv, nbf_, nb_, nb_, nb_, vb_);
                
                #pragma omp parallel
                {
                    #pragma omp for collapse(3) nowait
                    for(int j=0; j<nb_; ++j) for(int b=0; b<vb_; ++b) for(int c=0; c<vb_; ++c) {
                        int col = j*vb_*vb_ + b*vb_ + c;
                        // Perhatikan indeks: V_vovv_bb(a, j, b, c)
                        for(int a=0; a<vb_; ++a) V_a_jbc_b(a, col) = V_vovv_bb(a,b,j,c);
                        
                        for(int i=0; i<nb_; ++i) T_i_jbc_b(i, col) = t2_bb_(i,j,b,c) + L2_bb_(i,j,b,c);
                    }
                    #pragma omp for collapse(3)
                    for(int j=0; j<nb_; ++j) for(int k=0; k<nb_; ++k) for(int b=0; b<vb_; ++b) {
                        int col = j*nb_*vb_ + k*vb_ + b;
                        for(int i=0; i<nb_; ++i) V_i_jkb_b(i, col) = V_ooov_bb(j,i,k,b);
                        
                        for(int a=0; a<vb_; ++a) T_a_jkb_b(a, col) = t2_bb_(j,k,a,b) + L2_bb_(j,k,a,b);
                    }
                }
                L_nonsep_b += 0.5 * (V_a_jbc_b * T_i_jbc_b.transpose() - T_a_jkb_b * V_i_jkb_b.transpose());                
            }

            // 2. BA Channel untuk Beta
            if (na_ > 0 && va_ > 0) {
                // OPTIMASI: Ganti transform_custom dengan transform_oovv_mixed (DGEMM)
                auto V_vovv_ba = ERITransformer::transform_oovv_mixed(integrals_->compute_eri(), Cbv, Cao, Cbv, Cav, nbf_, vb_, na_, vb_, va_); 
                auto V_ooov_ba = ERITransformer::transform_oovv_mixed(integrals_->compute_eri(), Cbo, Cao, Cbo, Cav, nbf_, nb_, na_, nb_, va_);
                
                #pragma omp parallel
                {
                    #pragma omp for collapse(3) nowait
                    for(int j=0; j<na_; ++j) for(int b=0; b<vb_; ++b) for(int c=0; c<va_; ++c) {
                        int col = j*vb_*va_ + b*va_ + c;
                        // Perhatikan indeks: V_vovv_ba(a, j, b, c)
                        for(int a=0; a<vb_; ++a) V_a_jbc_ba(a, col) = V_vovv_ba(a,b,j,c);
                        
                        for(int i=0; i<nb_; ++i) T_i_jbc_ba(i, col) = t2_ab_(j,i,c,b) + L2_ab_(j,i,c,b);
                    }
                    #pragma omp for collapse(3)
                    for(int j=0; j<na_; ++j) for(int k=0; k<nb_; ++k) for(int b=0; b<va_; ++b) {
                        int col = j*nb_*va_ + k*va_ + b;
                        // Indeks ooov_ba untuk BA: (k_b, i_a, j_b, b_a) -> (k, i, j, b)
                        for(int i=0; i<nb_; ++i) V_i_jkb_ba(i, col) = V_ooov_ba(k,i,j,b);
                        
                        for(int a=0; a<vb_; ++a) T_a_jkb_ba(a, col) = t2_ab_(j,k,b,a) + L2_ab_(j,k,b,a);
                    }
                }
                L_nonsep_b += 1.0 * (V_a_jbc_ba * T_i_jbc_ba.transpose() - T_a_jkb_ba * V_i_jkb_ba.transpose());
                
            }

            Eigen::MatrixXd F_vo_b = F_mo_b.block(nb_, 0, vb_, nb_);
            Eigen::MatrixXd L_total_b = (G_vv_beta_ * F_vo_b - F_vo_b * G_oo_beta_) + L_nonsep_b;
            F_mo_b.block(nb_, 0, vb_, nb_) += L_total_b;
            F_mo_b.block(0, nb_, nb_, vb_) += L_total_b.transpose();
        }
        
       
        
        // 5. HITUNG GRADIENT DIRECTION (K_dir)
        double grad_norm = 0.0;
        Eigen::MatrixXd K_dir_a = Eigen::MatrixXd::Zero(nbf_, nbf_);
        Eigen::MatrixXd K_dir_b = Eigen::MatrixXd::Zero(nbf_, nbf_);
        double shift = 0.25;

        if (mode == "U") {
            Eigen::MatrixXd wa = 2.0 * F_mo_a.block(na_, 0, va_, na_);
            Eigen::MatrixXd wb = 2.0 * F_mo_b.block(nb_, 0, vb_, nb_);
            grad_norm = std::sqrt(wa.squaredNorm() + wb.squaredNorm());

            for(int a=0; a<va_; ++a) {
                for(int i=0; i<na_; ++i) {
                    double delta = scf_.orbital_energies_alpha(na_+a) - scf_.orbital_energies_alpha(i);
                    double denom = (delta >= 0) ? (delta + shift) : (delta - shift);
                    K_dir_a(na_+a, i) = wa(a,i)/denom; 
                    K_dir_a(i, na_+a) = -wa(a,i)/denom;
                }
            }
            for(int b=0; b<vb_; ++b) {
                for(int i=0; i<nb_; ++i) {
                    double delta = scf_.orbital_energies_beta(nb_+b) - scf_.orbital_energies_beta(i);
                    double denom = (delta >= 0) ? (delta + shift) : (delta - shift);
                    K_dir_b(nb_+b, i) = wb(b,i)/denom; 
                    K_dir_b(i, nb_+b) = -wb(b,i)/denom;
                }
            }
        } else {
            Eigen::MatrixXd F_uni = Eigen::MatrixXd::Zero(nbf_, nbf_);
            F_uni.block(0, na_, nb_, va_) = 0.5 * (F_mo_a.block(0, na_, nb_, va_) + F_mo_b.block(0, na_, nb_, va_));
            for(int i=0; i<nbf_; ++i) {
                for(int j=i+1; j<nbf_; ++j) {
                    double val = 2.0 * F_uni(i, j);
                    if (std::abs(val) > 1e-12) {
                        grad_norm += val * val;
                        double delta = scf_.orbital_energies_alpha(j) - scf_.orbital_energies_alpha(i);
                        double denom = (delta >= 0) ? (delta + shift) : (delta - shift);
                        K_dir_a(j, i) = val/denom; 
                        K_dir_a(i, j) = -val/denom;
                    }
                }
            }
            grad_norm = std::sqrt(grad_norm); 
            K_dir_b = K_dir_a;
        }

        // ---- KAPPA-DIIS (EKSTRAPOLASI ARAH ROTASI) ---
        diis_kappa_a.push(K_dir_a, F_mo_a.block(na_, 0, va_, na_));
        if (mode == "U") {
            diis_kappa_b.push(K_dir_b, F_mo_b.block(nb_, 0, vb_, nb_));
        }

        Eigen::MatrixXd K_dir_raw_a = K_dir_a;
        Eigen::MatrixXd K_dir_raw_b = K_dir_b;

        if (iter >= 2) {
            K_dir_a = diis_kappa_a.extrapolate();
            if (mode == "U") K_dir_b = diis_kappa_b.extrapolate();
            else K_dir_b = K_dir_a;
        }

        // --- LAKUKAN CLAMPING ---
        auto clamp_direction = [](Eigen::MatrixXd& K) {
            double max_val = K.cwiseAbs().maxCoeff();
            if (max_val > 0.05) K *= (0.05 / max_val);
        };

        clamp_direction(K_dir_a);
        if (mode == "U") clamp_direction(K_dir_b);
        else K_dir_b = K_dir_a;

        K_dir_a_last = K_dir_a;
        K_dir_b_last = K_dir_b;

        // Lanjut ke perhitungan dir_deriv dan armijo_line_search...

       
        
        // 6. LOGGING INFO
        if(omp_get_thread_num() == 0) {
            std::cout << std::setw(4) << iter << "    " 
                      << std::fixed << std::setprecision(8) << e_tot << "    "
                      << std::setprecision(8) << e_corr << "    " 
                      << std::scientific << std::setprecision(2) << grad_norm << "   "
                      << std::fixed << std::setprecision(4) << current_step << "\n";
        }
        
     

        // 8. HITUNG DIRECTIONAL DERIVATIVE
        double dir_deriv = 0.0;
        Eigen::MatrixXd grad_a_mat = 2.0 * F_mo_a.block(na_, 0, va_, na_);
        dir_deriv -= (grad_a_mat.cwiseProduct(K_dir_a_last.block(na_, 0, va_, na_))).sum();
        
        if (mode == "U") {
            Eigen::MatrixXd grad_b_mat = 2.0 * F_mo_b.block(nb_, 0, vb_, nb_);
            dir_deriv -= (grad_b_mat.cwiseProduct(K_dir_b_last.block(nb_, 0, vb_, nb_))).sum();
        } else {
            dir_deriv *= 2.0;
        }

        // --- TAMBAHKAN BLOK INI (SAFETY NET) ---
        // Jika arah rotasi menaikkan energi (Ascent Direction), kembalikan ke gradien murni dan reset DIIS
        if (dir_deriv > 0.0) {
            K_dir_a_last = K_dir_raw_a;
            K_dir_b_last = K_dir_raw_b;
            
            clamp_direction(K_dir_a_last);
            if (mode == "U") clamp_direction(K_dir_b_last);
            else K_dir_b_last = K_dir_a_last;

            // Hitung ulang dir_deriv dengan gradien murni
            dir_deriv = 0.0;
            dir_deriv -= (grad_a_mat.cwiseProduct(K_dir_a_last.block(na_, 0, va_, na_))).sum();
            if (mode == "U") {
                Eigen::MatrixXd grad_b_mat = 2.0 * F_mo_b.block(nb_, 0, vb_, nb_);
                dir_deriv -= (grad_b_mat.cwiseProduct(K_dir_b_last.block(nb_, 0, vb_, nb_))).sum();
            } else {
                dir_deriv *= 2.0;
            }

            diis_kappa_a = KappaDIIS(); 
            diis_kappa_b = KappaDIIS();
        }
        // Konvergen JIKA gradien sudah di bawah threshold. 
        // (dE sangat kecil hanya kita jadikan indikator gagal step/noise, tapi jangan paksa berhenti jika gradien masih besar)
        if (grad_norm < grad_thresh_) {
            is_converged = true;
            break;
        } else if (iter > 1 && std::abs(dE) < 1e-11 && current_step < 0.05) {
            // Hanya berhenti darurat jika dE mati kutu DAN step sudah terlalu kecil (stuck)
            if(omp_get_thread_num() == 0) std::cout << "  [INFO] Optimizer stuck (Noise floor). Forcing exit.\n";
            is_converged = true;
            break;
        }
    

    
        // 9. EKSEKUSI ROTASI ORBITAL DENGAN STEP AMAN
        rotate_orbitals(current_step, K_dir_a_last, K_dir_b_last);
        iter++;
    } // End of while loop

    OMP3Result result;
    result.energy_total = e_total_last;
    result.energy_mp3_corr = e_corr_last; // Mengandung MP2+MP3
    result.converged = is_converged;
    result.iterations = iter;
    return result;
}

// Unused stubs
void OMP3::compute_t2_amplitudes() { compute_mp2_energy(); }
double OMP3::compute_mp2_energy_from_t2() { return compute_mp2_energy(); }
void OMP3::build_mp3_density_contributions_alpha() {}
void OMP3::build_mp3_density_contributions_beta() {}
Eigen::MatrixXd OMP3::compute_orbital_gradient_alpha(const Eigen::MatrixXd&) { return Eigen::MatrixXd(); }
Eigen::MatrixXd OMP3::compute_orbital_gradient_beta(const Eigen::MatrixXd&) { return Eigen::MatrixXd(); }
void OMP3::rotate_orbitals_alpha(const Eigen::MatrixXd&, const Eigen::MatrixXd&) {}
void OMP3::rotate_orbitals_beta(const Eigen::MatrixXd&, const Eigen::MatrixXd&) {}
bool OMP3::converged(const Eigen::MatrixXd&, const Eigen::MatrixXd&, double, double) { return true; }
Eigen::MatrixXd OMP3::build_gfock_alpha(const Eigen::MatrixXd&, const Eigen::MatrixXd&) { return Eigen::MatrixXd(); }
Eigen::MatrixXd OMP3::build_gfock_beta(const Eigen::MatrixXd&, const Eigen::MatrixXd&) { return Eigen::MatrixXd(); }

} // namespace mshqc