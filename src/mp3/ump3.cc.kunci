/**
 * @file src/mp3/ump3.cc
 * @brief UMP3 Final: Fully Optimized & Robust GEMM
 * @details
 * - Fix: Replaced unsafe 'shuffle+Map' in AA/BB Ring terms with Explicit Packing.
 * - Optimization: All terms (Ladder & Ring) use Full GEMM with OpenMP packing.
 * - Result: Guaranteed memory layout consistency matching Matrix operations.
 */

#include "mshqc/ump3.h"
#include "mshqc/ump3_kernels.h" 
#include "mshqc/ump3_memory.h"
#include "mshqc/integrals/eri_transformer.h"
#include "mshqc/symmetry/point_group.h"
#include <iostream>
#include <iomanip>
#include <cmath>
#include <omp.h>
#include <algorithm>
#include <vector>
#include <chrono>
#include <Eigen/Dense>
#ifdef I
#undef I
#endif

namespace mshqc {

// ============================================================================
// 1. CONSTRUCTOR
// ============================================================================

UMP3::UMP3(const SCFResult& uhf, const UMP2Result& ump2, 
           const BasisSet& basis, 
           std::shared_ptr<IntegralEngine> integrals,
           std::shared_ptr<PointGroup> pg)
    : uhf_(uhf), ump2_(ump2), basis_(basis), integrals_(integrals), pg_(pg) 
{
    nbf_ = basis.n_basis_functions();
    nocc_a_ = uhf.n_occ_alpha;
    nocc_b_ = uhf.n_occ_beta;
    nvir_a_ = nbf_ - nocc_a_;
    nvir_b_ = nbf_ - nocc_b_;
}

// ============================================================================
// 2. TRANSFORM INTEGRALS
// ============================================================================

void UMP3::transform_integrals() {
    auto t_start = std::chrono::high_resolution_clock::now();
    if(omp_get_thread_num() == 0) std::cout << "  [UMP3] Pre-computing MP2 Integrals... " << std::flush;

    const auto& eri_ao = integrals_->compute_eri();
    using integrals::ERITransformer;

    const Eigen::MatrixXd& Cao = uhf_.C_alpha.leftCols(nocc_a_);
    const Eigen::MatrixXd& Cav = uhf_.C_alpha.rightCols(nvir_a_);
    const Eigen::MatrixXd& Cbo = uhf_.C_beta.leftCols(nocc_b_);
    const Eigen::MatrixXd& Cbv = uhf_.C_beta.rightCols(nvir_b_);

    // Simpan OVOV di Workspace
    auto& ovov_aa = workspace_.allocate("ovov_aa", nocc_a_, nvir_a_, nocc_a_, nvir_a_);
    ovov_aa = ERITransformer::transform_ovov(eri_ao, Cao, Cav, nbf_, nocc_a_, nvir_a_);

    auto& ovov_bb = workspace_.allocate("ovov_bb", nocc_b_, nvir_b_, nocc_b_, nvir_b_);
    ovov_bb = ERITransformer::transform_ovov(eri_ao, Cbo, Cbv, nbf_, nocc_b_, nvir_b_);

    auto& ovov_ab = workspace_.allocate("ovov_ab", nocc_a_, nvir_a_, nocc_b_, nvir_b_);
    ovov_ab = ERITransformer::transform_oovv_mixed(eri_ao, Cao, Cbo, Cav, Cbv, nbf_, nocc_a_, nocc_b_, nvir_a_, nvir_b_);

    auto& oovv_aa = workspace_.allocate("oovv_aa", nocc_a_, nocc_a_, nvir_a_, nvir_a_);
    oovv_aa = ERITransformer::transform_oo_vv_mixed(eri_ao, Cao, Cao, Cav, Cav, nbf_, nocc_a_, nocc_a_, nvir_a_, nvir_a_);

    auto& oovv_bb = workspace_.allocate("oovv_bb", nocc_b_, nocc_b_, nvir_b_, nvir_b_);
    oovv_bb = ERITransformer::transform_oo_vv_mixed(eri_ao, Cbo, Cbo, Cbv, Cbv, nbf_, nocc_b_, nocc_b_, nvir_b_, nvir_b_);

    auto& oovv_ab_ex = workspace_.allocate("oovv_ab_ex", nocc_a_, nocc_a_, nvir_b_, nvir_b_);
    oovv_ab_ex = ERITransformer::transform_oo_vv_mixed(eri_ao, Cao, Cao, Cbv, Cbv, nbf_, nocc_a_, nocc_a_, nvir_b_, nvir_b_);

    auto& oovv_ba_ex = workspace_.allocate("oovv_ba_ex", nocc_b_, nocc_b_, nvir_a_, nvir_a_);
    oovv_ba_ex = ERITransformer::transform_oo_vv_mixed(eri_ao, Cbo, Cbo, Cav, Cav, nbf_, nocc_b_, nocc_b_, nvir_a_, nvir_a_);
    auto t_end = std::chrono::high_resolution_clock::now();
    double dt = std::chrono::duration<double>(t_end - t_start).count();
    if(omp_get_thread_num() == 0) std::cout << "Done (" << std::fixed << std::setprecision(2) << dt << "s).\n";
}

// ============================================================================
// 3. COMPUTE T2 AMPLITUDES
// ============================================================================

void UMP3::compute_mp2_amplitudes() {
    t2_aa_.resize(nocc_a_, nocc_a_, nvir_a_, nvir_a_);
    t2_bb_.resize(nocc_b_, nocc_b_, nvir_b_, nvir_b_);
    t2_ab_.resize(nocc_a_, nocc_b_, nvir_a_, nvir_b_);
    
    const auto& ea = uhf_.orbital_energies_alpha;
    const auto& eb = uhf_.orbital_energies_beta;

    const auto& g_ovov_aa = workspace_.get("ovov_aa");
    const auto& g_ovov_bb = workspace_.get("ovov_bb");
    const auto& g_ovov_ab = workspace_.get("ovov_ab");

    // AA
    #pragma omp parallel for collapse(2)
    for(int i=0; i<nocc_a_; ++i) {
        for(int j=0; j<nocc_a_; ++j) {
            for(int a=0; a<nvir_a_; ++a) {
                for(int b=0; b<nvir_a_; ++b) {
                    double D = ea(i) + ea(j) - ea(nocc_a_+a) - ea(nocc_a_+b);
                    if(std::abs(D) > 1e-12) 
                        t2_aa_(i,j,a,b) = (g_ovov_aa(i,a,j,b) - g_ovov_aa(i,b,j,a)) / D;
                    else t2_aa_(i,j,a,b) = 0.0;
                }
            }
        }
    }

    // BB
    #pragma omp parallel for collapse(2)
    for(int i=0; i<nocc_b_; ++i) {
        for(int j=0; j<nocc_b_; ++j) {
            for(int a=0; a<nvir_b_; ++a) {
                for(int b=0; b<nvir_b_; ++b) {
                    double D = eb(i) + eb(j) - eb(nocc_b_+a) - eb(nocc_b_+b);
                    if(std::abs(D) > 1e-12) 
                        t2_bb_(i,j,a,b) = (g_ovov_bb(i,a,j,b) - g_ovov_bb(i,b,j,a)) / D;
                    else t2_bb_(i,j,a,b) = 0.0;
                }
            }
        }
    }

    // AB
    #pragma omp parallel for collapse(2)
    for(int i=0; i<nocc_a_; ++i) {
        for(int j=0; j<nocc_b_; ++j) {
            for(int a=0; a<nvir_a_; ++a) {
                for(int b=0; b<nvir_b_; ++b) {
                    double D = ea(i) + eb(j) - ea(nocc_a_+a) - eb(nocc_b_+b);
                    if(std::abs(D) > 1e-12) 
                        t2_ab_(i,j,a,b) = g_ovov_ab(i,a,j,b) / D;
                    else t2_ab_(i,j,a,b) = 0.0;
                }
            }
        }
    }
}

// ============================================================================
// 4. PACKING HELPERS (EXPLICIT LOOP)
// ============================================================================

// Pack Tensor V(a,c,b,d) -> Matrix M(ab, cd) for Ladder VVVV
Eigen::MatrixXd pack_ladder_vvvv_as(const Eigen::Tensor<double, 4>& V, int nv) {
    Eigen::MatrixXd M(nv*nv, nv*nv);
    #pragma omp parallel for collapse(2)
    for(int ab = 0; ab < nv*nv; ++ab) {
        for(int cd = 0; cd < nv*nv; ++cd) {
            int a = ab / nv; int b = ab % nv;
            int c = cd / nv; int d = cd % nv;
            // <ab||cd> = <ab|cd> - <ab|dc>
            // V is (a, c, b, d) -> <ac|bd> in physicist? No, mshqc usually V(a,c,b,d) = (ab|cd) chemist
            // Consistent with UMP3 kernels: M(ab, cd) = V(a,c,b,d) - V(a,d,b,c)
            M(ab, cd) = V(a,c,b,d) - V(a,d,b,c);
        }
    }
    return M;
}

// Pack Tensor V(k,i,l,j) -> Matrix M(kl, ij) for Ladder OOOO
Eigen::MatrixXd pack_ladder_oooo_as(const Eigen::Tensor<double, 4>& V, int no) {
    Eigen::MatrixXd M(no*no, no*no);
    #pragma omp parallel for collapse(2)
    for(int kl = 0; kl < no*no; ++kl) {
        for(int ij = 0; ij < no*no; ++ij) {
            int k = kl / no; int l = kl % no;
            int i = ij / no; int j = ij % no;
            M(kl, ij) = V(k,i,l,j) - V(k,j,l,i);
        }
    }
    return M;
}

// Pack T2(i,j,a,b) -> Matrix M(ij, ab)
Eigen::MatrixXd pack_t2_ij_ab(const Eigen::Tensor<double, 4>& T2, int no, int nv) {
    Eigen::MatrixXd M(no*no, nv*nv);
    #pragma omp parallel for collapse(2)
    for(int ij = 0; ij < no*no; ++ij) {
        for(int ab = 0; ab < nv*nv; ++ab) {
            int i = ij / no; int j = ij % no;
            int a = ab / nv; int b = ab % nv;
            M(ij, ab) = T2(i,j,a,b);
        }
    }
    return M;
}


// ============================================================================
// 5. COMPUTE MP3 ENERGY (MEMORY AWARE & SAFE)
// ============================================================================

void UMP3::compute_mp3_energy(UMP3Result& r) {
    if(omp_get_thread_num() == 0) std::cout << "  [UMP3] Computing Energy (Low-Memory Mode)...\n";
    
    const auto& eri_ao = integrals_->compute_eri();
    using integrals::ERITransformer;
    const Eigen::MatrixXd& Cao = uhf_.C_alpha.leftCols(nocc_a_);
    const Eigen::MatrixXd& Cav = uhf_.C_alpha.rightCols(nvir_a_);
    const Eigen::MatrixXd& Cbo = uhf_.C_beta.leftCols(nocc_b_);
    const Eigen::MatrixXd& Cbv = uhf_.C_beta.rightCols(nvir_b_);

    // ---------------- LADDER TERM AA ----------------
    {
        auto& V = workspace_.allocate("vvvv_aa", nvir_a_, nvir_a_, nvir_a_, nvir_a_);
        V = ERITransformer::transform_vvvv(eri_ao, Cav, nbf_, nvir_a_);
        Eigen::MatrixXd V_mat = pack_ladder_vvvv_as(V, nvir_a_);
        Eigen::MatrixXd T_mat = pack_t2_ij_ab(t2_aa_, nocc_a_, nvir_a_);
        Eigen::MatrixXd W = T_mat * V_mat; 
        r.e3_aa += 0.125 * T_mat.cwiseProduct(W).sum(); 
        workspace_.free("vvvv_aa"); 
    }
    {
        auto& V = workspace_.allocate("oooo_aa", nocc_a_, nocc_a_, nocc_a_, nocc_a_);
        V = ERITransformer::transform_oooo(eri_ao, Cao, nbf_, nocc_a_);
        Eigen::MatrixXd V_mat = pack_ladder_oooo_as(V, nocc_a_);
        Eigen::MatrixXd T_mat = pack_t2_ij_ab(t2_aa_, nocc_a_, nvir_a_);
        Eigen::MatrixXd W = V_mat.transpose() * T_mat;
        r.e3_aa += 0.125 * T_mat.cwiseProduct(W).sum(); 
        workspace_.free("oooo_aa");
    }

    // ---------------- LADDER TERM BB ----------------
    {
        auto& V = workspace_.allocate("vvvv_bb", nvir_b_, nvir_b_, nvir_b_, nvir_b_);
        V = ERITransformer::transform_vvvv(eri_ao, Cbv, nbf_, nvir_b_);
        Eigen::MatrixXd V_mat = pack_ladder_vvvv_as(V, nvir_b_);
        Eigen::MatrixXd T_mat = pack_t2_ij_ab(t2_bb_, nocc_b_, nvir_b_);
        Eigen::MatrixXd W = T_mat * V_mat; 
        r.e3_bb += 0.125 * T_mat.cwiseProduct(W).sum(); 
        workspace_.free("vvvv_bb");
    }
    {
        auto& V = workspace_.allocate("oooo_bb", nocc_b_, nocc_b_, nocc_b_, nocc_b_);
        V = ERITransformer::transform_oooo(eri_ao, Cbo, nbf_, nocc_b_);
        Eigen::MatrixXd V_mat = pack_ladder_oooo_as(V, nocc_b_);
        Eigen::MatrixXd T_mat = pack_t2_ij_ab(t2_bb_, nocc_b_, nvir_b_);
        Eigen::MatrixXd W = V_mat.transpose() * T_mat;
        r.e3_bb += 0.125 * T_mat.cwiseProduct(W).sum(); 
        workspace_.free("oooo_bb");
    }


    // ---------------- LADDER TERM AB (MIXED) ----------------
    {
        auto& V = workspace_.allocate("vvvv_ab", nvir_a_, nvir_a_, nvir_b_, nvir_b_);
        V = ERITransformer::transform_vvvv_mixed(eri_ao, Cav, Cbv, nbf_, nvir_a_, nvir_b_);
        
        Eigen::array<long, 4> shuf = {0, 2, 1, 3}; 
        Eigen::Tensor<double, 4> V_shuf = V.shuffle(shuf);
        r.e3_ab += kernels::contract_ladder_pp(t2_ab_, V_shuf, 1.0); 
        workspace_.free("vvvv_ab");
    }
    {
        auto& V = workspace_.allocate("oooo_ab", nocc_a_, nocc_a_, nocc_b_, nocc_b_);
        V = ERITransformer::transform_oooo_mixed(eri_ao, Cao, Cbo, nbf_, nocc_a_, nocc_b_);
        
        Eigen::array<long, 4> shuf = {0, 2, 1, 3};
        Eigen::Tensor<double, 4> V_shuf = V.shuffle(shuf);
        r.e3_ab += kernels::contract_ladder_hh(t2_ab_, V_shuf, 1.0); 
        workspace_.free("oooo_ab");
    }

   // ---------------- RING TERMS (Explicit Packing) ----------------
    
    const auto& g_ovov_aa = workspace_.get("ovov_aa");
    const auto& g_ovov_bb = workspace_.get("ovov_bb");
    const auto& g_ovov_ab = workspace_.get("ovov_ab");

    // ====================================================================
    // 1. Ring AA - EXACT V*T FORMULATION (Pure Spin)
    // ====================================================================
    {
        int dim = nocc_a_ * nvir_a_;
        const auto& g_oovv_aa = workspace_.get("oovv_aa");
        
        Eigen::MatrixXd V_AA(dim, dim);
        #pragma omp parallel for collapse(2)
        for(int ia=0; ia<dim; ++ia) {
            for(int kc=0; kc<dim; ++kc) {
                int i = ia / nvir_a_; int a = ia % nvir_a_;
                int k = kc / nvir_a_; int c = kc % nvir_a_;
                // <ak||ic>_phys = (ai|kc)_chem - (ki|ac)_chem
                V_AA(ia, kc) = g_ovov_aa(i,a,k,c) - g_oovv_aa(k,i,a,c);
            }
        }
        
        Eigen::MatrixXd T_right(dim, dim);
        #pragma omp parallel for collapse(2)
        for(int kc=0; kc<dim; ++kc) {
            for(int jb=0; jb<dim; ++jb) {
                int k = kc / nvir_a_; int c = kc % nvir_a_;
                int j = jb / nvir_a_; int b = jb % nvir_a_;
                // t(k,j,c,b) -> Menghubungkan indeks k,c dari integral ke j,b
                T_right(kc, jb) = t2_aa_(k,j,c,b);
            }
        }
        
        Eigen::MatrixXd W = V_AA * T_right;
        
        Eigen::MatrixXd T_final(dim, dim);
        #pragma omp parallel for collapse(2)
        for(int ia=0; ia<dim; ++ia) {
            for(int jb=0; jb<dim; ++jb) {
                int i = ia / nvir_a_; int a = ia % nvir_a_;
                int j = jb / nvir_a_; int b = jb % nvir_a_;
                T_final(ia, jb) = t2_aa_(i,j,a,b);
            }
        }
        r.e3_aa += 1.0 * T_final.cwiseProduct(W).sum(); 
    }

    // ====================================================================
    // 2. RING TERM AA (Cross-Spin / Inner Beta)
    // ====================================================================
    {
        Eigen::MatrixXd V_cross(nocc_a_ * nvir_a_, nocc_b_ * nvir_b_);
        Eigen::MatrixXd T_cross(nocc_b_ * nvir_b_, nocc_a_ * nvir_a_);

        #pragma omp parallel for collapse(2)
        for (int i = 0; i < nocc_a_; ++i) {
            for (int a = 0; a < nvir_a_; ++a) {
                int ia = i * nvir_a_ + a;
                for (int k = 0; k < nocc_b_; ++k) {
                    for (int c = 0; c < nvir_b_; ++c) {
                        int kc = k * nvir_b_ + c;
                        // <a_a k_b || i_a c_b> maps to direct (i_a a_a | k_b c_b)
                        V_cross(ia, kc) = g_ovov_ab(i, a, k, c);
                    }
                }
            }
        }
        
        #pragma omp parallel for collapse(2)
        for (int k = 0; k < nocc_b_; ++k) {
            for (int c = 0; c < nvir_b_; ++c) {
                int kc = k * nvir_b_ + c;
                for (int j = 0; j < nocc_a_; ++j) {
                    for (int b = 0; b < nvir_a_; ++b) {
                        int jb = j * nvir_a_ + b;
                        // t^{c_b b_a}_{k_b j_a} mapped by antisymmetry to t2_ab_(j, k, b, c)
                        T_cross(kc, jb) = t2_ab_(j, k, b, c);
                    }
                }
            }
        }

        Eigen::MatrixXd W_cross = V_cross * T_cross;
        
        // Re-pack T_final for AA to ensure shape safety
        Eigen::MatrixXd T_final_AA(nocc_a_ * nvir_a_, nocc_a_ * nvir_a_);
        #pragma omp parallel for collapse(2)
        for (int i = 0; i < nocc_a_; ++i) {
            for (int a = 0; a < nvir_a_; ++a) {
                for (int j = 0; j < nocc_a_; ++j) {
                    for (int b = 0; b < nvir_a_; ++b) {
                        T_final_AA(i * nvir_a_ + a, j * nvir_a_ + b) = t2_aa_(i, j, a, b);
                    }
                }
            }
        }
        
        r.e3_aa += 1.0 * T_final_AA.cwiseProduct(W_cross).sum();
    }

    // ====================================================================
    // 3. Ring BB - EXACT V*T FORMULATION (Pure Spin)
    // ====================================================================
    {
        int dim = nocc_b_ * nvir_b_;
        const auto& g_oovv_bb = workspace_.get("oovv_bb");
        
        Eigen::MatrixXd V_BB(dim, dim);
        #pragma omp parallel for collapse(2)
        for(int ia=0; ia<dim; ++ia) {
            for(int kc=0; kc<dim; ++kc) {
                int i = ia / nvir_b_; int a = ia % nvir_b_;
                int k = kc / nvir_b_; int c = kc % nvir_b_;
                V_BB(ia, kc) = g_ovov_bb(i,a,k,c) - g_oovv_bb(k,i,a,c);
            }
        }
        
        Eigen::MatrixXd T_right(dim, dim);
        #pragma omp parallel for collapse(2)
        for(int kc=0; kc<dim; ++kc) {
            for(int jb=0; jb<dim; ++jb) {
                int k = kc / nvir_b_; int c = kc % nvir_b_;
                int j = jb / nvir_b_; int b = jb % nvir_b_;
                T_right(kc, jb) = t2_bb_(k,j,c,b);
            }
        }
        
        Eigen::MatrixXd W = V_BB * T_right;
        
        Eigen::MatrixXd T_final(dim, dim);
        #pragma omp parallel for collapse(2)
        for(int ia=0; ia<dim; ++ia) {
            for(int jb=0; jb<dim; ++jb) {
                int i = ia / nvir_b_; int a = ia % nvir_b_;
                int j = jb / nvir_b_; int b = jb % nvir_b_;
                T_final(ia, jb) = t2_bb_(i,j,a,b);
            }
        }
        r.e3_bb += 1.0 * T_final.cwiseProduct(W).sum();
    }

    // ====================================================================
    // 4. RING TERM BB (Cross-Spin / Inner Alpha)
    // ====================================================================
    {
        Eigen::MatrixXd V_cross_bb(nocc_b_ * nvir_b_, nocc_a_ * nvir_a_);
        Eigen::MatrixXd T_cross_bb(nocc_a_ * nvir_a_, nocc_b_ * nvir_b_);

        #pragma omp parallel for collapse(2)
        for (int i = 0; i < nocc_b_; ++i) {
            for (int a = 0; a < nvir_b_; ++a) {
                int ia = i * nvir_b_ + a;
                for (int k = 0; k < nocc_a_; ++k) {
                    for (int c = 0; c < nvir_a_; ++c) {
                        int kc = k * nvir_a_ + c;
                        // <a_b k_a || i_b c_a> maps to direct (k_a c_a | i_b a_b)
                        V_cross_bb(ia, kc) = g_ovov_ab(k, c, i, a);
                    }
                }
            }
        }
        
        #pragma omp parallel for collapse(2)
        for (int k = 0; k < nocc_a_; ++k) {
            for (int c = 0; c < nvir_a_; ++c) {
                int kc = k * nvir_a_ + c;
                for (int j = 0; j < nocc_b_; ++j) {
                    for (int b = 0; b < nvir_b_; ++b) {
                        int jb = j * nvir_b_ + b;
                        // t^{c_a b_b}_{k_a j_b} mapped to t2_ab_(k, j, c, b)
                        T_cross_bb(kc, jb) = t2_ab_(k, j, c, b);
                    }
                }
            }
        }

        Eigen::MatrixXd W_cross_bb = V_cross_bb * T_cross_bb;
        
        Eigen::MatrixXd T_final_BB(nocc_b_ * nvir_b_, nocc_b_ * nvir_b_);
        #pragma omp parallel for collapse(2)
        for (int i = 0; i < nocc_b_; ++i) {
            for (int a = 0; a < nvir_b_; ++a) {
                for (int j = 0; j < nocc_b_; ++j) {
                    for (int b = 0; b < nvir_b_; ++b) {
                        T_final_BB(i * nvir_b_ + a, j * nvir_b_ + b) = t2_bb_(i, j, a, b);
                    }
                }
            }
        }
        
        r.e3_bb += 1.0 * T_final_BB.cwiseProduct(W_cross_bb).sum();
    }

    // ---------------- Ring AB (Mixed) - EXACT FORMULA ----------------
    {
        const auto& g_oovv_ab_ex = workspace_.get("oovv_ab_ex");
        const auto& g_oovv_ba_ex = workspace_.get("oovv_ba_ex");

        int dim_ia = nocc_a_ * nvir_a_;
        int dim_jb = nocc_b_ * nvir_b_;
        int dim_kca = nocc_a_ * nvir_a_;
        int dim_kcb = nocc_b_ * nvir_b_;

        Eigen::MatrixXd T_iajb(dim_ia, dim_jb);
        #pragma omp parallel for collapse(2)
        for(int i=0; i<nocc_a_; ++i) for(int a=0; a<nvir_a_; ++a) {
            int row = i*nvir_a_ + a;
            for(int j=0; j<nocc_b_; ++j) for(int b=0; b<nvir_b_; ++b) 
                T_iajb(row, j*nvir_b_ + b) = t2_ab_(i,j,a,b);
        }

        Eigen::MatrixXd W_total = Eigen::MatrixXd::Zero(dim_ia, dim_jb);

        // Term 1: V_AA * T_AB
        {
            const auto& g_oovv_aa = workspace_.get("oovv_aa");
            Eigen::MatrixXd V_AA(dim_ia, dim_kca);
            #pragma omp parallel for collapse(2)
            for(int i=0; i<nocc_a_; ++i) for(int a=0; a<nvir_a_; ++a) {
                int row = i*nvir_a_ + a;
                for(int k=0; k<nocc_a_; ++k) for(int c=0; c<nvir_a_; ++c) 
                    V_AA(row, k*nvir_a_ + c) = g_ovov_aa(i,a,k,c) - g_oovv_aa(i,k,a,c);
            }
            W_total += V_AA * T_iajb; 
        }

        // Term 2: T_AB_ik * V_BB
        {
            const auto& g_oovv_bb = workspace_.get("oovv_bb");
            Eigen::MatrixXd T_AB_ik(dim_ia, dim_kcb);
            #pragma omp parallel for collapse(2)
            for(int i=0; i<nocc_a_; ++i) for(int a=0; a<nvir_a_; ++a) {
                int row = i*nvir_a_ + a;
                for(int k=0; k<nocc_b_; ++k) for(int c=0; c<nvir_b_; ++c) 
                    T_AB_ik(row, k*nvir_b_ + c) = t2_ab_(i,k,a,c);
            }
            
            Eigen::MatrixXd V_BB(dim_kcb, dim_jb);
            #pragma omp parallel for collapse(2)
            for(int k=0; k<nocc_b_; ++k) for(int c=0; c<nvir_b_; ++c) {
                int row = k*nvir_b_ + c;
                for(int j=0; j<nocc_b_; ++j) for(int b=0; b<nvir_b_; ++b) 
                    V_BB(row, j*nvir_b_ + b) = g_ovov_bb(k,c,j,b) - g_oovv_bb(k,j,c,b);
            }
            W_total += T_AB_ik * V_BB; 
        }

        // Term 3: T_AA * V_AB 
        {
            Eigen::MatrixXd T_AA(dim_ia, dim_kca);
            #pragma omp parallel for collapse(2)
            for(int i=0; i<nocc_a_; ++i) for(int a=0; a<nvir_a_; ++a) {
                int row = i*nvir_a_ + a;
                for(int k=0; k<nocc_a_; ++k) for(int c=0; c<nvir_a_; ++c) 
                    T_AA(row, k*nvir_a_ + c) = t2_aa_(i,k,a,c);
            }
            
            Eigen::MatrixXd V_AB(dim_kca, dim_jb);
            #pragma omp parallel for collapse(2)
            for(int k=0; k<nocc_a_; ++k) for(int c=0; c<nvir_a_; ++c) {
                int row = k*nvir_a_ + c;
                for(int j=0; j<nocc_b_; ++j) for(int b=0; b<nvir_b_; ++b) 
                    V_AB(row, j*nvir_b_ + b) = g_ovov_ab(k, c, j, b);
            }
            W_total += T_AA * V_AB;
        }

        // Term 4: V_AB_Term4 * T_BB
        {
            Eigen::MatrixXd V_AB_Term4(dim_ia, dim_kcb);
            #pragma omp parallel for collapse(2)
            for(int i=0; i<nocc_a_; ++i) for(int a=0; a<nvir_a_; ++a) {
                int row = i*nvir_a_ + a;
                for(int k=0; k<nocc_b_; ++k) for(int c=0; c<nvir_b_; ++c) 
                    V_AB_Term4(row, k*nvir_b_ + c) = g_ovov_ab(i, a, k, c); 
            }
            
            Eigen::MatrixXd T_BB(dim_kcb, dim_jb);
            #pragma omp parallel for collapse(2)
            for(int k=0; k<nocc_b_; ++k) for(int c=0; c<nvir_b_; ++c) {
                int row = k*nvir_b_ + c;
                for(int j=0; j<nocc_b_; ++j) for(int b=0; b<nvir_b_; ++b) 
                    T_BB(row, j*nvir_b_ + b) = t2_bb_(k,j,c,b);
            }
            W_total += V_AB_Term4 * T_BB;
        }

        // Term 5: CROSS TERM 1 
        {
            int dim_ib = nocc_a_ * nvir_b_;
            int dim_kc = nocc_a_ * nvir_b_;
            int dim_ja = nocc_b_ * nvir_a_;
            
            Eigen::MatrixXd V_C1(dim_ib, dim_kc);
            #pragma omp parallel for collapse(2)
            for(int i=0; i<nocc_a_; ++i) for(int b=0; b<nvir_b_; ++b) {
                int row = i*nvir_b_ + b;
                for(int k=0; k<nocc_a_; ++k) for(int c=0; c<nvir_b_; ++c) {
                    V_C1(row, k*nvir_b_ + c) = g_oovv_ab_ex(i,k,b,c); 
                }
            }
            
            Eigen::MatrixXd T_C1(dim_kc, dim_ja);
            #pragma omp parallel for collapse(2)
            for(int k=0; k<nocc_a_; ++k) for(int c=0; c<nvir_b_; ++c) {
                int row = k*nvir_b_ + c;
                for(int j=0; j<nocc_b_; ++j) for(int a=0; a<nvir_a_; ++a) {
                    T_C1(row, j*nvir_a_ + a) = t2_ab_(k,j,a,c);
                }
            }
            
            Eigen::MatrixXd W_C1 = V_C1 * T_C1;
            
            #pragma omp parallel for collapse(2)
            for(int i=0; i<nocc_a_; ++i) for(int a=0; a<nvir_a_; ++a) {
                for(int j=0; j<nocc_b_; ++j) for(int b=0; b<nvir_b_; ++b) {
                    W_total(i*nvir_a_ + a, j*nvir_b_ + b) -= W_C1(i*nvir_b_ + b, j*nvir_a_ + a);
                }
            }
        }

        // Term 6: CROSS TERM 2 
        {
            int dim_ja = nocc_b_ * nvir_a_;
            int dim_kc = nocc_b_ * nvir_a_;
            int dim_ib = nocc_a_ * nvir_b_;
            
            Eigen::MatrixXd V_C2(dim_ja, dim_kc);
            #pragma omp parallel for collapse(2)
            for(int j=0; j<nocc_b_; ++j) for(int a=0; a<nvir_a_; ++a) {
                int row = j*nvir_a_ + a;
                for(int k=0; k<nocc_b_; ++k) for(int c=0; c<nvir_a_; ++c) {
                    V_C2(row, k*nvir_a_ + c) = g_oovv_ba_ex(j,k,a,c);
                }
            }
            
            Eigen::MatrixXd T_C2(dim_kc, dim_ib);
            #pragma omp parallel for collapse(2)
            for(int k=0; k<nocc_b_; ++k) for(int c=0; c<nvir_a_; ++c) {
                int row = k*nvir_a_ + c;
                for(int i=0; i<nocc_a_; ++i) for(int b=0; b<nvir_b_; ++b) {
                    T_C2(row, i*nvir_b_ + b) = t2_ab_(i,k,c,b);
                }
            }
            
            Eigen::MatrixXd W_C2 = V_C2 * T_C2;
            
            #pragma omp parallel for collapse(2)
            for(int i=0; i<nocc_a_; ++i) for(int a=0; a<nvir_a_; ++a) {
                for(int j=0; j<nocc_b_; ++j) for(int b=0; b<nvir_b_; ++b) {
                    W_total(i*nvir_a_ + a, j*nvir_b_ + b) -= W_C2(j*nvir_a_ + a, i*nvir_b_ + b);
                }
            }
        }

        r.e3_ab += 1.0 * T_iajb.cwiseProduct(W_total).sum();
    }

    // Free shared OVOV integrals
    workspace_.clear_all();

    if(omp_get_thread_num() == 0) std::cout << "Done.\n";
    r.e_mp3 = r.e3_aa + r.e3_bb + r.e3_ab;
}

// ============================================================================
// MAIN COMPUTE LOOP
// ============================================================================
UMP3Result UMP3::compute() {
    auto start_time = std::chrono::high_resolution_clock::now();
    if(omp_get_thread_num() == 0) {
        std::cout << "\n========================================\n";
        std::cout << "  UMP3 (CANONICAL + SPHERICAL + LOW MEM)\n";
        std::cout << "========================================\n";
        std::cout << "  Threads: " << omp_get_max_threads() << "\n";
    }

    transform_integrals();
    compute_mp2_amplitudes();
    
    UMP3Result result;
    result.e_uhf = uhf_.energy_total;
    result.e_mp2 = ump2_.e_corr_total;
    
    compute_mp3_energy(result);
    
    result.e_corr_total = result.e_mp2 + result.e_mp3;
    result.e_total = result.e_uhf + result.e_corr_total;

    auto end_time = std::chrono::high_resolution_clock::now();
    double elapsed = std::chrono::duration<double>(end_time - start_time).count();

    if(omp_get_thread_num() == 0) {
        std::cout << "\n=== UMP3 Results ===\n";
        std::cout << std::fixed << std::setprecision(8);
        std::cout << "  MP3 Correction:  " << std::setw(14) << result.e_mp3 << " Ha\n";
        std::cout << "    > AA: " << result.e3_aa << "\n";
        std::cout << "    > BB: " << result.e3_bb << "\n";
        std::cout << "    > AB: " << result.e3_ab << "\n";
        std::cout << "  Total Energy:    " << result.e_total << " Ha\n";
        std::cout << "  Time:            " << elapsed << " s\n";
        std::cout << "========================================\n";
    }
    return result;
}

// Unused interface helpers
double UMP3::tensor_norm(const Eigen::Tensor<double, 4>& t) { return 0.0; }
Eigen::Tensor<double, 4> UMP3::manual_transform_chem(const Eigen::Tensor<double, 4>&, const Eigen::MatrixXd&, int, const Eigen::MatrixXd&, int, const Eigen::MatrixXd&, int, const Eigen::MatrixXd&, int, int) { return Eigen::Tensor<double, 4>(); }

} // namespace mshqc